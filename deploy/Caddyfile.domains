# Companies' own domains (docs/companies.md › A company's own domain): an address that is not one of
# ours, like erp.acme.com, which a company pointed here with one CNAME record to connect.__DOMAIN__.
#
# This block takes every address no other block of the server's Caddyfile names. A certificate is made
# on demand, and only for a domain the API says is a company's (the same check as the companies'
# addresses: on_demand_tls { ask … } in the global options, see Caddyfile.companies).
#
# After adding it and reloading Caddy, switch the feature on: OWN_DOMAINS=true in /opt/kebo-desk/.env,
# then `sudo docker compose up -d`. Until then nothing is offered to companies and no domain is served.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	request_body {
		max_size 30MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	handle /api/* {
		reverse_proxy kebo-desk-api:4000
	}
	handle {
		reverse_proxy kebo-desk-web:3000
	}
}
