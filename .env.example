# Copy to .env (root) — packages/database and apps/api read it.
DATABASE_URL=postgres://kebo:kebo@localhost:5433/kebo
AUTH_SECRET=replace-with-openssl-rand-base64-48-output-xxxxxxxx
APP_URL=http://localhost:3000
APP_TIME_ZONE=Asia/Shanghai
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API (Caddy = 1). Only then is X-Forwarded-For trusted.
TRUST_PROXY=0
# Browsers over HTTPS: send the session cookie only on secure connections.
COOKIE_SECURE=false
