# ---------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# --- Required for Docker (docker-compose.yml) ---
POSTGRES_PASSWORD=change-me-to-a-strong-password
# File storage (MinIO). Generate with: openssl rand -base64 24
MINIO_ROOT_USER=kebo
MINIO_ROOT_PASSWORD=change-me-to-another-strong-password
# Session signing secret. Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Docker names and ports (safe on a server shared with other apps; see deploy/README.md)
COMPOSE_PROJECT_NAME=kebo-rfq
APP_PORT=3410
# On a server whose Caddy runs in Docker on a shared network, also set:
# COMPOSE_FILE=docker-compose.yml:deploy/compose.shared-proxy.yml
# PROXY_NETWORK=global-proxy

# Your domain (Caddy gets an HTTPS certificate). For LAN-only use :80 and COOKIE_SECURE=false
DOMAIN=qms.example.com
APP_URL=https://qms.example.com
COOKIE_SECURE=true

# Starting accounts (created by the seed; an account that already exists is not changed).
#   Super Admin = the developer: everything, including users and settings
#   Manager     = runs work and sales: all inquiries, assigning, quotations, invoices, payments, reports, audit log
#   Staff       = does the work and sales: own inquiries, customers and quotations
# On the server an account is created only when its email and password are set here
# (Staff are normally added later under Users).
SEED_ADMIN_NAME="Fawad Iqbal"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_MANAGER_NAME="Faizur Rehman"
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=Manager@12345
SEED_MANAGER2_NAME="Tanveer ul Haq"
SEED_MANAGER2_EMAIL=manager2@example.com
SEED_MANAGER2_PASSWORD=Manager@12345
SEED_STAFF_NAME="Kebo Staff"
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=Staff@12345

# Admin emails notified about new queries etc. (pre-fills Settings on first setup; change later in Settings)
NOTIFY_EMAILS="info@keboint.com, shandongkeboint@gmail.com"

# Websites allowed to send their RFQ form here
PUBLIC_FORM_ORIGINS=https://keboint.com,https://www.keboint.com

# --- Optional ---
APP_TIME_ZONE=Asia/Shanghai
DAILY_SUMMARY_HOUR=8
MAX_UPLOAD_MB=25
REMINDER_INTERVAL_MINUTES=60
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR=2

# Outgoing email (needed for admin notifications). Example for Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=shandongkeboint@gmail.com
#   SMTP_PASSWORD=<a Google "App password", not the normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Kebo RFQ Desk <no-reply@keboint.com>"

# --- Local development only (npm run dev) ---
DATABASE_URL=postgres://qms:qms@localhost:5433/qms
# Files go to the dev MinIO from docker-compose.dev.yml
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kebo-files
S3_ACCESS_KEY=kebo
S3_SECRET_KEY=kebo-dev-password
# Or keep files in a folder instead: STORAGE_DRIVER=local and UPLOAD_DIR=./storage/uploads

# --- PDF download (quotations and invoices) ---
# PDFs are printed by headless Chrome from the app's own print page, so they
# look exactly like it. The Docker image includes Chromium. For local
# development, an installed Chrome or Edge is found automatically; set
# CHROME_PATH only if yours is somewhere unusual.
# CHROME_PATH=
# Where that browser reaches the app (default: http://127.0.0.1:$PORT, i.e. port 3000).
# PDF_RENDER_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------- Security
# Roles that must use two-step sign-in (authenticator app), e.g. admin,manager.
# Empty (default) = nobody is asked; anyone can still turn it on in My account.
TWO_STEP_REQUIRED_ROLES=
# Cloudflare Turnstile secret for the website form (empty = off). Only after the widget is on the website.
TURNSTILE_SECRET_KEY=
# Off-site encrypted backup copy (off while OFFSITE_S3_BUCKET is empty). See deploy/README.md.
BACKUP_ENCRYPTION_KEY=
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=auto
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=
