# HTTPS reverse proxy. With a real domain in DOMAIN, Caddy gets a free
# Let's Encrypt certificate automatically. For a LAN-only server use
# DOMAIN=:80 (plain HTTP) and set COOKIE_SECURE=false.
{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 30MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy app:3000
}
