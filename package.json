{
  "name": "kebo",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@kebo/api --filter=@kebo/web",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @kebo/database db:generate",
    "db:migrate": "pnpm --filter @kebo/database db:migrate",
    "db:deploy": "pnpm --filter @kebo/database db:deploy",
    "db:seed": "turbo run build --filter=@kebo/database^... --output-logs=errors-only && pnpm --filter @kebo/database db:seed",
    "db:reset": "turbo run build --filter=@kebo/database^... --output-logs=errors-only && pnpm --filter @kebo/database db:reset",
    "db:load-data": "turbo run build --filter=@kebo/database^... --output-logs=errors-only && pnpm --filter @kebo/database db:load-data",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "dev:packages": "turbo run dev --filter=./packages/*"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "~6.0.3"
  }
}
