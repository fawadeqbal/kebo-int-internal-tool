{
  "name": "@kebo/ui",
  "version": "0.1.0",
  "private": true,
  "description": "The design system: tokens (theme.css), server-safe components and client components. Compiled by the Next.js app (transpilePackages).",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.tsx",
    "./theme.css": "./src/styles/theme.css"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@kebo/shared": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": { "next": ">=16", "react": ">=19", "react-dom": ">=19" },
  "devDependencies": {
    "@kebo/config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "~6.0.3"
  }
}
