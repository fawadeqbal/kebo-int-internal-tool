{
  "name": "@kebo/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript/ESLint presets and the typed environment loader.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.mjs", "require": "./dist/index.js" },
    "./eslint": "./eslint.config.mjs",
    "./tsconfig/*": "./tsconfig/*"
  },
  "files": ["dist", "tsconfig", "eslint.config.mjs"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "zod": "4.6.7" },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "tsup": "^8.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
