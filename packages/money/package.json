{
  "name": "@kebo/money",
  "version": "0.1.0",
  "private": true,
  "description": "All money maths in integer minor units: totals, VAT, discounts, FX, margins, deposits, settlement and profit.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.mjs", "require": "./dist/index.js" } },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@kebo/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "tsup": "^8.5.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
