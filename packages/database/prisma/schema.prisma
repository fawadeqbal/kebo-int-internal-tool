// Kebo deal tracker: the data model.
//
// Conventions
// - Tables and columns are snake_case in Postgres (@@map / @map); models are PascalCase.
// - Money: Decimal(14,2) columns, always handled as integer minor units in code (@kebo/money).
// - Calendar dates (due, issued, paid) are DATE columns with no time of day.
// - Business records are soft-deleted (deleted_at) so history never disappears.
// - Enum values match @kebo/shared/enums (a test checks they stay in sync).
// - Snapshot JSON columns freeze who a document was for/from when it was sent or issued.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

/// What happened at one sign-in attempt.
enum SignInResult {
  signed_in
  code_needed
  wrong_password
  unknown_email
  wrong_code
  locked
  switched_off
  too_many
}

enum InquiryStage {
  new
  sourcing
  quoted
  won
  lost
}

enum InquiryChannel {
  website
  whatsapp
  wechat
  email
  phone
  visit
  other
}

enum Priority {
  low
  normal
  high
  urgent
}

enum LostReason {
  price_too_high
  no_reply
  factory_cannot_supply
  bought_elsewhere
  customer_cancelled
  duplicate_or_spam
  other
}

enum CustomerType {
  company
  individual
}

/// One option of a quotation revision: open while the customer decides; then one is accepted and the others not chosen.
enum OptionStatus {
  open
  accepted
  not_chosen
}

enum RevisionStatus {
  draft
  sent
  accepted
  rejected
  expired
  superseded
  /// Accepted, but its order was later cancelled.
  void
}

enum LineType {
  goods
  service
  charge
}

/// The costs between a factory's price basis and ours (to the port, sea freight, insurance, destination delivery, import duties).
enum BasisStep {
  to_port
  freight
  insurance
  delivery
  duties
}

enum Incoterm {
  EXW
  FCA
  FAS
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP
}

enum BalanceTerms {
  before_shipment
  against_bl_copy
  after_arrival
  letter_of_credit
}

enum OrderStatus {
  open
  closed
  cancelled
}

/// Confirmed → In production → Shipped → Done, one button at a time (cancelled is the status).
enum OrderStage {
  confirmed
  in_production
  shipped
  done

  @@map("order_stage")
}

enum PaymentKind {
  deposit
  balance
  other
}

/// Where money is kept: cash in the office, a bank account, a wallet (Alipay, JazzCash…).
enum MoneyAccountKind {
  cash
  bank
  wallet
}

enum PaymentMethod {
  bank_transfer
  letter_of_credit
  cash
  cheque
  online
  other
}

// ============================================================================
// Platform: people, sign-in, settings, numbering, audit, notifications
// ============================================================================

/// A set of permissions people are given (Security). The key never changes; presets: admin (Super Admin), manager, staff.
model Role {
  key            String   @db.VarChar(40)
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId      String   @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company        Company  @relation(fields: [companyId], references: [id])
  name           String   @db.VarChar(60)
  description    String?  @db.VarChar(300)
  /// Permission names (@kebo/shared PERMISSIONS); ignored for the Super Admin, who has every one.
  permissions    String[] @default([])
  superAdmin     Boolean  @default(false) @map("super_admin")
  /// Everyone in the role must use two-step sign-in: they set it up before they can do anything else.
  requireTwoStep Boolean  @default(false) @map("require_two_step")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users User[]

  @@id([companyId, key])
  @@unique([companyId, name])
  @@map("roles")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId       String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company         Company   @relation(fields: [companyId], references: [id])
  /// Set on the hidden account a platform admin works through when they open this company.
  platformAdminId String?   @map("platform_admin_id") @db.Uuid
  name            String    @db.VarChar(120)
  email           String    @db.VarChar(254)
  passwordHash    String    @map("password_hash")
  /// The role's key.
  role            String    @db.VarChar(40)
  access          Role      @relation(fields: [companyId, role], references: [companyId, key], onUpdate: Cascade)
  isActive        Boolean   @default(true) @map("is_active")
  /// Built-in account that records website inquiries; can never sign in.
  isSystem        Boolean   @default(false) @map("is_system")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  failedLogins    Int       @default(0) @map("failed_logins")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz
  /// Two-step sign-in: encrypted authenticator secret; on once totpEnabledAt is set.
  totpSecret      String?   @map("totp_secret")
  totpEnabledAt   DateTime? @map("totp_enabled_at") @db.Timestamptz
  totpLastStep    Int?      @map("totp_last_step")
  /// sha256 hashes of unused recovery codes.
  recoveryCodes   String[]  @default([]) @map("recovery_codes")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions      Session[]
  signIns       SignIn[]
  devices       DeviceToken[]
  notifications Notification[]
  assignedDeals Inquiry[]          @relation("InquiryAssignee")
  createdDeals  Inquiry[]          @relation("InquiryCreator")
  orderMoves    OrderStageChange[]
  factories     Factory[]          @relation("FactoryOwner")
  factoryPaid   FactoryPayment[]   @relation("FactoryPaymentPaidBy")
  expensesPaid  Expense[]          @relation("ExpensePaidBy")

  reminderStates ReminderState[]

  /// What they made or did (kept when they are switched off; people are not deleted).
  relCustomerCreator        Customer[]           @relation("CustomerCreator")
  relFactoryCreator         Factory[]            @relation("FactoryCreator")
  relInquiryStageChanger    InquiryStageChange[] @relation("InquiryStageChanger")
  relAssignmentAssignee     InquiryAssignment[]  @relation("AssignmentAssignee")
  relAssignmentAssigner     InquiryAssignment[]  @relation("AssignmentAssigner")
  relNoteAuthor             InquiryNote[]        @relation("NoteAuthor")
  relAttachmentUploader     Attachment[]         @relation("AttachmentUploader")
  relFactoryQuoteCreator    FactoryQuote[]       @relation("FactoryQuoteCreator")
  relRevisionCreator        QuotationRevision[]  @relation("RevisionCreator")
  relOrderCreator           Order[]              @relation("OrderCreator")
  relFactoryPaymentRecorder FactoryPayment[]     @relation("FactoryPaymentRecorder")
  relExpenseRecorder        Expense[]            @relation("ExpenseRecorder")
  relPaymentRecorder        Payment[]            @relation("PaymentRecorder")
  relTransferRecorder       MoneyTransfer[]      @relation("TransferRecorder")
  relTargetUpdater          SalesTarget[]        @relation("TargetUpdater")
  relAuditUser              AuditLog[]           @relation("AuditUser")

  @@unique([companyId, email])
  @@map("users")
}

/// One row per signed-in browser or phone; the token only carries this id, so sign-out and deactivation end sessions at once.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId      String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company        Company   @relation(fields: [companyId], references: [id])
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  userAgent      String?   @map("user_agent") @db.VarChar(300)
  ip             String?   @db.VarChar(64)
  /// Signed in, but the second step (authenticator code) is not done yet.
  pendingTwoStep Boolean   @default(false) @map("pending_two_step")

  devices DeviceToken[]

  @@index([userId])
  @@index([companyId])
  @@map("sessions")
}

/// Every sign-in attempt, right or wrong (Security → Sign-ins; My account shows a person's own).
model SignIn {
  id        String       @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String       @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company      @relation(fields: [companyId], references: [id])
  /// Null when the email is not anyone's.
  userId    String?      @map("user_id") @db.Uuid
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String       @db.VarChar(254)
  result    SignInResult
  /// e.g. "with a recovery code".
  detail    String?      @db.VarChar(120)
  ip        String       @db.VarChar(64)
  userAgent String?      @map("user_agent") @db.VarChar(300)
  at        DateTime     @default(now()) @db.Timestamptz

  @@index([at])
  @@index([userId, at])
  @@index([companyId])
  @@map("sign_ins")
}

/// Phones that receive push notifications.
model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId  String   @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id])
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String?  @map("session_id") @db.Uuid
  session    Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// One row per phone per company (the same phone may be signed in to two companies).
  token      String
  platform   String   @default("android") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz

  @@unique([companyId, token])
  @@index([userId])
  @@index([companyId])
  @@map("device_tokens")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id])
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(60)
  title     String    @db.VarChar(255)
  body      String?
  link      String?   @db.VarChar(255)
  /// Stops the reminder job sending the same reminder twice.
  dedupeKey String?   @map("dedupe_key") @db.VarChar(200)
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([companyId])
  @@map("notifications")
}

/// Who changed what, with old and new values.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId  String   @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id])
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.Uuid
  summary    String?
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  /// Why the change was made (asked where a change affects others; see @kebo/shared workflows/reasons).
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([companyId])
  @@map("audit_logs")
}

/// Company profile, defaults, reminder rules, plan timings: one JSON value per key.
model Setting {
  key       String   @db.VarChar(100)
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String   @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([companyId, key])
  @@map("settings")
}

/// Gap-free yearly counters for document numbers (RFQ-2026-0001, SO-2026-0001…).
model Counter {
  key       String  @db.VarChar(50)
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String  @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])
  value     Int     @default(0)

  @@id([companyId, key])
  @@map("counters")
}

// ============================================================================
// Parties: customers (with contacts) and factories
// ============================================================================

model Customer {
  id              String       @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId       String       @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company         Company      @relation(fields: [companyId], references: [id])
  type            CustomerType @default(company)
  name            String       @db.VarChar(200)
  /// ISO 3166-1 alpha-2 (e.g. NG, AE): where the goods go. China (CN) means a domestic sale with VAT.
  country         String       @db.Char(2)
  address         String?
  /// Business license / tax number (shown on documents as "Business License Number").
  taxNo           String?      @map("tax_no") @db.VarChar(60)
  /// Registration number (shown on documents as "Reg. Number").
  regNo           String?      @map("reg_no") @db.VarChar(60)
  defaultCurrency String       @default("USD") @map("default_currency") @db.Char(3)
  /// Short letters for the customer on documents, e.g. "TN" in proforma KEB260916TN07. Empty: taken from the name.
  initials        String?      @db.VarChar(6)
  notes           String?
  createdById     String?      @map("created_by") @db.Uuid
  createdBy       User?        @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  contacts  Contact[]
  inquiries Inquiry[]
  orders    Order[]
  payments  Payment[]
  expenses  Expense[]

  @@index([name])
  @@index([country])
  @@index([companyId])
  @@map("customers")
}

model Contact {
  id         String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId  String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company    Company   @relation(fields: [companyId], references: [id])
  customerId String    @map("customer_id") @db.Uuid
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String    @db.VarChar(120)
  position   String?   @db.VarChar(80)
  email      String?   @db.VarChar(254)
  phone      String?   @db.VarChar(40)
  whatsapp   String?   @db.VarChar(40)
  wechat     String?   @db.VarChar(80)
  isPrimary  Boolean   @default(false) @map("is_primary")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  inquiries Inquiry[]

  @@index([customerId])
  @@index([email])
  @@index([phone])
  @@index([whatsapp])
  @@index([companyId])
  @@map("contacts")
}

model Factory {
  id            String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId     String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company       Company   @relation(fields: [companyId], references: [id])
  name          String    @db.VarChar(200)
  contactPerson String?   @map("contact_person") @db.VarChar(120)
  phone         String?   @db.VarChar(40)
  wechat        String?   @db.VarChar(80)
  email         String?   @db.VarChar(254)
  address       String?
  bankDetails   String?   @map("bank_details")
  notes         String?
  /// The person in our team who looks after this factory.
  ownerId       String?   @map("owner_id") @db.Uuid
  owner         User?     @relation("FactoryOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById   String?   @map("created_by") @db.Uuid
  createdBy     User?     @relation("FactoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  quotes     FactoryQuote[]
  payments   FactoryPayment[]
  expenses   Expense[]
  orderLines OrderLine[]

  @@index([name])
  @@index([ownerId])
  @@index([companyId])
  @@map("factories")
}

// ============================================================================
// Sales: the inquiry (deal) and what the customer asked for
// ============================================================================

model Inquiry {
  id           String         @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId    String         @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company      Company        @relation(fields: [companyId], references: [id])
  /// RFQ-2026-0001
  refNo        String         @map("ref_no") @db.VarChar(30)
  customerId   String         @map("customer_id") @db.Uuid
  customer     Customer       @relation(fields: [customerId], references: [id])
  contactId    String?        @map("contact_id") @db.Uuid
  contact      Contact?       @relation(fields: [contactId], references: [id])
  channel      InquiryChannel @default(email)
  category     String         @db.VarChar(120)
  title        String         @db.VarChar(200)
  /// Anything else the customer said: destination port, standards, delivery…
  requirements String?
  priority     Priority       @default(normal)
  requiredBy   DateTime?      @map("required_by") @db.Date
  stage        InquiryStage   @default(new)
  onHold       Boolean        @default(false) @map("on_hold")
  lostReason   LostReason?    @map("lost_reason")
  lostNote     String?        @map("lost_note")
  assigneeId   String?        @map("assignee_id") @db.Uuid
  assignee     User?          @relation("InquiryAssignee", fields: [assigneeId], references: [id])
  createdById  String         @map("created_by") @db.Uuid
  createdBy    User           @relation("InquiryCreator", fields: [createdById], references: [id])
  /// When it was won or lost (turnaround = closedAt − createdAt).
  closedAt     DateTime?      @map("closed_at") @db.Timestamptz
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  items         RequestedItem[]
  stageChanges  InquiryStageChange[]
  assignments   InquiryAssignment[]
  notes         InquiryNote[]
  attachments   Attachment[]
  factoryQuotes FactoryQuote[]
  quotation     Quotation?
  /// At most one order that is not cancelled (partial unique index in the integrity migration).
  orders        Order[]
  expenses      Expense[]

  @@unique([companyId, refNo])
  @@index([stage])
  @@index([assigneeId])
  @@index([customerId])
  @@index([createdAt])
  @@map("inquiries")
}

model RequestedItem {
  id          String          @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId   String          @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company     Company         @relation(fields: [companyId], references: [id])
  inquiryId   String          @map("inquiry_id") @db.Uuid
  inquiry     Inquiry         @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// A part of another item, split at factory pricing (numbered 3.1, 3.2 under item 3). One level only.
  parentId    String?         @map("parent_id") @db.Uuid
  parent      RequestedItem?  @relation("ItemParts", fields: [parentId], references: [id], onDelete: Cascade)
  parts       RequestedItem[] @relation("ItemParts")
  description String
  model       String?         @db.VarChar(120)
  quantity    Decimal         @db.Decimal(12, 2)
  unit        String          @default("pcs") @db.VarChar(20)
  targetPrice Decimal?        @map("target_price") @db.Decimal(14, 2)
  sortOrder   Int             @default(0) @map("sort_order")

  factoryLines FactoryQuoteLine[] @relation("AnswersItem")
  quoteLines   QuoteLine[]

  @@index([inquiryId])
  @@index([parentId])
  @@index([companyId])
  @@map("requested_items")
}

/// Every stage move, automatic or by hand; turnaround and time-in-stage come from here.
model InquiryStageChange {
  id          String        @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId   String        @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company     Company       @relation(fields: [companyId], references: [id])
  inquiryId   String        @map("inquiry_id") @db.Uuid
  inquiry     Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fromStage   InquiryStage? @map("from_stage")
  toStage     InquiryStage  @map("to_stage")
  /// What caused it: a person ("manual") or an event ("quotation_sent"…).
  cause       String        @default("manual") @db.VarChar(40)
  lostReason  LostReason?   @map("lost_reason")
  note        String?
  changedById String?       @map("changed_by") @db.Uuid
  changedBy   User?         @relation("InquiryStageChanger", fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime      @default(now()) @map("changed_at") @db.Timestamptz

  @@index([inquiryId])
  @@index([companyId])
  @@map("inquiry_stage_changes")
}

model InquiryAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId    String   @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company      Company  @relation(fields: [companyId], references: [id])
  inquiryId    String   @map("inquiry_id") @db.Uuid
  inquiry      Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  assigneeId   String?  @map("assignee_id") @db.Uuid
  assignee     User?    @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedById String   @map("assigned_by") @db.Uuid
  assignedBy   User     @relation("AssignmentAssigner", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  @@index([inquiryId])
  @@index([companyId])
  @@map("inquiry_assignments")
}

model InquiryNote {
  id        String   @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String   @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  inquiryId String   @map("inquiry_id") @db.Uuid
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  body      String
  authorId  String   @map("author_id") @db.Uuid
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([inquiryId])
  @@index([companyId])
  @@map("inquiry_notes")
}

/// Files on a deal. Optionally tied to an order step (inspection report, payment slip, B/L copy).
model Attachment {
  id             String        @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId      String        @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company        Company       @relation(fields: [companyId], references: [id])
  inquiryId      String        @map("inquiry_id") @db.Uuid
  inquiry        Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// The factory offer this file is evidence for (its quotation, catalogue, WeChat screenshots). Internal: only people who see factory prices.
  factoryQuoteId String?       @map("factory_quote_id") @db.Uuid
  factoryQuote   FactoryQuote? @relation(fields: [factoryQuoteId], references: [id], onDelete: SetNull)
  fileName       String        @map("file_name") @db.VarChar(255)
  mimeType       String        @map("mime_type") @db.VarChar(150)
  size           Int
  storageKey     String        @map("storage_key")
  /// urs | drawing | photo | specification | factory_quote | other
  kind           String        @default("other") @db.VarChar(20)
  note           String?       @db.VarChar(300)
  uploadedById   String        @map("uploaded_by") @db.Uuid
  uploadedBy     User          @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([inquiryId])
  @@index([factoryQuoteId])
  @@index([companyId])
  @@map("attachments")
}

// ============================================================================
// Sourcing: factory prices for a deal (internal, never shown to customers)
// ============================================================================

model FactoryQuote {
  id           String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId    String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company      Company   @relation(fields: [companyId], references: [id])
  inquiryId    String    @map("inquiry_id") @db.Uuid
  inquiry      Inquiry   @relation(fields: [inquiryId], references: [id])
  factoryId    String    @map("factory_id") @db.Uuid
  factory      Factory   @relation(fields: [factoryId], references: [id])
  /// The factory's own quotation number.
  reference    String?   @db.VarChar(80)
  receivedOn   DateTime  @map("received_on") @db.Date
  validUntil   DateTime? @map("valid_until") @db.Date
  currency     String    @default("CNY") @db.Char(3)
  /// The factory's price basis (EXW, FOB, CFR…): what its prices already pay for.
  basis        Incoterm?
  /// Where the basis applies: "Zhangjiagang" (EXW), "Qingdao" (FOB)…
  basisPlace   String?   @map("basis_place") @db.VarChar(60)
  leadTime     String?   @map("lead_time") @db.VarChar(120)
  moq          String?   @db.VarChar(60)
  paymentTerms String?   @map("payment_terms")
  notes        String?
  createdById  String    @map("created_by") @db.Uuid
  createdBy    User      @relation("FactoryQuoteCreator", fields: [createdById], references: [id])
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  lines   FactoryQuoteLine[]
  options QuotationOption[]
  files   Attachment[]

  @@index([inquiryId])
  @@index([factoryId])
  @@index([companyId])
  @@map("factory_quotes")
}

model FactoryQuoteLine {
  id              String             @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId       String             @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company         Company            @relation(fields: [companyId], references: [id])
  factoryQuoteId  String             @map("factory_quote_id") @db.Uuid
  factoryQuote    FactoryQuote       @relation(fields: [factoryQuoteId], references: [id], onDelete: Cascade)
  /// The customer's item this answers (empty for extras the factory added).
  requestedItemId String?            @map("requested_item_id") @db.Uuid
  requestedItem   RequestedItem?     @relation("AnswersItem", fields: [requestedItemId], references: [id], onDelete: SetNull)
  description     String
  model           String?            @db.VarChar(120)
  quantity        Decimal            @db.Decimal(12, 2)
  unit            String             @default("pcs") @db.VarChar(20)
  /// The factory's price for one unit, without tax.
  unitPrice       Decimal            @map("unit_price") @db.Decimal(14, 2)
  /// Tax % added on top of this item's price (13 unless changed): price + tax is what one unit costs Kebo.
  taxRate         Decimal            @default(13) @map("tax_rate") @db.Decimal(5, 2)
  sortOrder       Int                @default(0) @map("sort_order")
  /// A part of another line of the same offer (the factory's own breakdown: machine, conveyor, spares…).
  parentId        String?            @map("parent_id") @db.Uuid
  parent          FactoryQuoteLine?  @relation("FactoryLineParts", fields: [parentId], references: [id], onDelete: Cascade)
  parts           FactoryQuoteLine[] @relation("FactoryLineParts")
  /// The same product across factories' offers: a line copied from another offer keeps that line's key, so offers can be compared product by product.
  productKey      String?            @map("product_key") @db.Uuid

  quoteLines QuoteLine[]

  @@index([factoryQuoteId])
  @@index([parentId])
  @@index([productKey])
  @@index([companyId])
  @@map("factory_quote_lines")
}

// ============================================================================
// Quotation: one per deal, with revisions R1, R2…
// ============================================================================

model Quotation {
  id        String   @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String   @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  /// QUO-2026-0007 (revisions print as QUO-2026-0007 R2)
  refNo     String   @map("ref_no") @db.VarChar(30)
  inquiryId String   @unique @map("inquiry_id") @db.Uuid
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  revisions QuotationRevision[]

  @@unique([companyId, refNo])
  @@map("quotations")
}

model QuotationRevision {
  id               String         @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId        String         @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company          Company        @relation(fields: [companyId], references: [id])
  quotationId      String         @map("quotation_id") @db.Uuid
  quotation        Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  number           Int
  status           RevisionStatus @default(draft)
  currency         String         @default("USD") @db.Char(3)
  incoterm         Incoterm       @default(FOB)
  incotermPlace    String?        @map("incoterm_place") @db.VarChar(80)
  depositPercent   Decimal        @default(30) @map("deposit_percent") @db.Decimal(5, 2)
  balanceTerms     BalanceTerms   @default(before_shipment) @map("balance_terms")
  leadTime         String?        @map("lead_time") @db.VarChar(120)
  validUntil       DateTime       @map("valid_until") @db.Date
  subtotal         Decimal        @default(0) @db.Decimal(14, 2)
  discount         Decimal        @default(0) @db.Decimal(14, 2)
  total            Decimal        @default(0) @db.Decimal(14, 2)
  /// Payment terms printed on the quotation (beyond the deposit and balance above), e.g. "By T/T; L/C at sight accepted".
  paymentTerms     String?        @map("payment_terms")
  /// Delivery terms printed on the quotation, e.g. "Packing: export wooden cases. Inspection before shipment."
  deliveryTerms    String?        @map("delivery_terms")
  notes            String?
  sentOn           DateTime?      @map("sent_on") @db.Date
  answeredOn       DateTime?      @map("answered_on") @db.Date
  /// Frozen when sent, so the PDF never changes afterwards.
  customerSnapshot Json?          @map("customer_snapshot")
  companySnapshot  Json?          @map("company_snapshot")
  createdById      String         @map("created_by") @db.Uuid
  createdBy        User           @relation("RevisionCreator", fields: [createdById], references: [id])
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  options QuotationOption[]
  lines   QuoteLine[]
  order   Order?

  @@unique([quotationId, number])
  @@index([status])
  @@index([companyId])
  @@map("quotation_revisions")
}

/// An option the customer can choose: one factory's offer (its lines, our prices),
/// or, without factory prices, the customer's own items priced by hand.
model QuotationOption {
  id                String            @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId         String            @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company           Company           @relation(fields: [companyId], references: [id])
  revisionId        String            @map("revision_id") @db.Uuid
  revision          QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  /// A, B, C…
  letter            String            @db.VarChar(2)
  sortOrder         Int               @default(0) @map("sort_order")
  factoryQuoteId    String?           @map("factory_quote_id") @db.Uuid
  factoryQuote      FactoryQuote?     @relation(fields: [factoryQuoteId], references: [id])
  status            OptionStatus      @default(open)
  leadTime          String?           @map("lead_time") @db.VarChar(120)
  subtotal          Decimal           @default(0) @db.Decimal(14, 2)
  discount          Decimal           @default(0) @db.Decimal(14, 2)
  total             Decimal           @default(0) @db.Decimal(14, 2)
  /// The factory's price basis when the option was saved (the offer can change later).
  factoryBasis      Incoterm?         @map("factory_basis")
  factoryBasisPlace String?           @map("factory_basis_place") @db.VarChar(60)

  lines QuoteLine[]
  costs OptionCost[]

  @@unique([revisionId, letter])
  @@index([factoryQuoteId])
  @@index([companyId])
  @@map("quotation_options")
}

/// A cost between the factory's price basis and the one we sell on (EXW → FOB: to the port…), part of the option's cost.
model OptionCost {
  id        String          @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String          @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company         @relation(fields: [companyId], references: [id])
  optionId  String          @map("option_id") @db.Uuid
  option    QuotationOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  step      BasisStep
  /// As entered, in its own currency.
  amount    Decimal         @db.Decimal(14, 2)
  currency  String          @db.Char(3)
  /// In the quotation's currency, at the rate when saved.
  cost      Decimal         @db.Decimal(14, 2)
  fxRate    Decimal?        @map("fx_rate") @db.Decimal(18, 8)
  note      String?         @db.VarChar(200)

  @@unique([optionId, step])
  @@index([companyId])
  @@map("option_costs")
}

model QuoteLine {
  id                 String            @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId          String            @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company            Company           @relation(fields: [companyId], references: [id])
  revisionId         String            @map("revision_id") @db.Uuid
  revision           QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  optionId           String            @map("option_id") @db.Uuid
  option             QuotationOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  requestedItemId    String?           @map("requested_item_id") @db.Uuid
  requestedItem      RequestedItem?    @relation(fields: [requestedItemId], references: [id], onDelete: SetNull)
  type               LineType          @default(goods)
  description        String
  model              String?           @db.VarChar(120)
  quantity           Decimal           @db.Decimal(12, 2)
  unit               String            @default("pcs") @db.VarChar(20)
  unitPrice          Decimal           @map("unit_price") @db.Decimal(14, 2)
  lineTotal          Decimal           @map("line_total") @db.Decimal(14, 2)
  /// Internal costing (never printed): what one unit costs us in the quotation currency, and where from.
  unitCost           Decimal?          @map("unit_cost") @db.Decimal(14, 2)
  factoryQuoteLineId String?           @map("factory_quote_line_id") @db.Uuid
  factoryQuoteLine   FactoryQuoteLine? @relation(fields: [factoryQuoteLineId], references: [id], onDelete: SetNull)
  /// Factory currency units per quotation currency unit when the cost was converted.
  fxRate             Decimal?          @map("fx_rate") @db.Decimal(24, 14)
  sortOrder          Int               @default(0) @map("sort_order")

  orderLines OrderLine[]

  @@index([revisionId])
  @@index([optionId])
  @@index([companyId])
  @@map("quote_lines")
}

// ============================================================================
// Orders: made when a revision is accepted; the checklist lives here
// ============================================================================

model Order {
  id               String            @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId        String            @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company          Company           @relation(fields: [companyId], references: [id])
  /// SO-2026-0001
  refNo            String            @map("ref_no") @db.VarChar(30)
  inquiryId        String            @map("inquiry_id") @db.Uuid
  inquiry          Inquiry           @relation(fields: [inquiryId], references: [id])
  revisionId       String            @unique @map("revision_id") @db.Uuid
  revision         QuotationRevision @relation(fields: [revisionId], references: [id])
  customerId       String            @map("customer_id") @db.Uuid
  customer         Customer          @relation(fields: [customerId], references: [id])
  status           OrderStatus       @default(open)
  stage            OrderStage        @default(confirmed)
  /// When the order entered its current stage.
  stageSince       DateTime          @default(now()) @map("stage_since") @db.Timestamptz
  orderedOn        DateTime          @map("ordered_on") @db.Date
  /// The proforma invoice's number once issued, e.g. KEB260916TN07 (prefix, issue date, customer letters, the handler's count this year).
  proformaNo       String?           @map("proforma_no") @db.VarChar(40)
  proformaIssuedOn DateTime?         @map("proforma_issued_on") @db.Date
  /// Ship date promised to the customer.
  shipBy           DateTime?         @map("ship_by") @db.Date
  /// Ready date the factory confirmed.
  readyOn          DateTime?         @map("ready_on") @db.Date
  shippedOn        DateTime?         @map("shipped_on") @db.Date
  blNo             String?           @map("bl_no") @db.VarChar(60)
  /// Heading over the lines on the documents, e.g. "COMPLETE AUTOMATIC LIQUID SYRUP FILLING LINE".
  documentTitle    String?           @map("document_title") @db.VarChar(200)
  /// Where the goods are unloaded, e.g. "Hairatan, Afghanistan" (the port of loading is the Incoterm place).
  portOfDischarge  String?           @map("port_of_discharge") @db.VarChar(120)
  /// When the packing list was filled in (null: not yet).
  packedAt         DateTime?         @map("packed_at") @db.Timestamptz
  containerNo      String?           @map("container_no") @db.VarChar(120)
  shippingMarks    String?           @map("shipping_marks")
  currency         String            @db.Char(3)
  total            Decimal           @db.Decimal(14, 2)
  depositPercent   Decimal           @map("deposit_percent") @db.Decimal(5, 2)
  balanceTerms     BalanceTerms      @map("balance_terms")
  incoterm         Incoterm
  incotermPlace    String?           @map("incoterm_place") @db.VarChar(80)
  /// The main currency when the order was made, and how many of the order's currency one unit of it bought
  /// (USD order, USD main: 1; CNY order: 7.1). Revenue and costs are turned into the main currency at this rate,
  /// so changing the rates in Settings never moves past months. Empty: not known (Settings is used).
  mainCurrency     String?           @map("main_currency") @db.Char(3)
  mainRate         Decimal?          @map("main_rate") @db.Decimal(24, 14)
  closedAt         DateTime?         @map("closed_at") @db.Timestamptz
  cancelledAt      DateTime?         @map("cancelled_at") @db.Timestamptz
  cancelReason     String?           @map("cancel_reason")
  createdById      String            @map("created_by") @db.Uuid
  createdBy        User              @relation("OrderCreator", fields: [createdById], references: [id])
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  lines        OrderLine[]
  stageChanges OrderStageChange[]
  payments     Payment[]
  planItems    PaymentPlanItem[]
  factoryPaid  FactoryPayment[]
  expenses     Expense[]
  costs        OrderCost[]

  @@unique([companyId, refNo])
  @@unique([companyId, proformaNo])
  @@index([inquiryId])
  @@index([status])
  @@index([stage])
  @@index([customerId])
  @@map("orders")
}

/// The accepted lines, frozen; shipped and invoiced quantities are tracked against them.
model OrderLine {
  id          String     @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId   String     @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company     Company    @relation(fields: [companyId], references: [id])
  orderId     String     @map("order_id") @db.Uuid
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quoteLineId String?    @map("quote_line_id") @db.Uuid
  quoteLine   QuoteLine? @relation(fields: [quoteLineId], references: [id], onDelete: SetNull)
  type        LineType   @default(goods)
  description String
  model       String?    @db.VarChar(120)
  quantity    Decimal    @db.Decimal(12, 2)
  unit        String     @default("pcs") @db.VarChar(20)
  unitPrice   Decimal    @map("unit_price") @db.Decimal(14, 2)
  lineTotal   Decimal    @map("line_total") @db.Decimal(14, 2)
  unitCost    Decimal?   @map("unit_cost") @db.Decimal(14, 2)
  sortOrder   Int        @default(0) @map("sort_order")

  /// The factory's price this line was bought at, frozen when the order was made: what we owe the
  /// factory is worked out from these, so changing or removing the offer later never changes it.
  factoryId        String?  @map("factory_id") @db.Uuid
  factory          Factory? @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  factoryUnitPrice Decimal? @map("factory_unit_price") @db.Decimal(14, 2)
  factoryTaxRate   Decimal? @map("factory_tax_rate") @db.Decimal(5, 2)
  factoryCurrency  String?  @map("factory_currency") @db.Char(3)

  /// How many have come in from the factory so far (goods lines), and when last.
  receivedQty   Decimal   @default(0) @map("received_qty") @db.Decimal(12, 2)
  receivedOn    DateTime? @map("received_on") @db.Date
  /// The packing list, filled in before shipping (goods lines).
  packages      Int?
  packageType   String?   @map("package_type") @db.VarChar(40)
  netWeightKg   Decimal?  @map("net_weight_kg") @db.Decimal(12, 2)
  grossWeightKg Decimal?  @map("gross_weight_kg") @db.Decimal(12, 2)
  cbm           Decimal?  @db.Decimal(10, 3)

  @@index([orderId])
  @@index([factoryId])
  @@index([companyId])
  @@map("order_lines")
}

/// A cost between the factory's price basis and the one we sold on (EXW → CFR: to the port, sea freight…),
/// copied from the accepted option when the order was made: part of the order's cost.
model OrderCost {
  id        String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String    @default(dbgenerated("(current_setting('app.company_id'::text))::uuid")) @map("company_id") @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id])
  orderId   String    @map("order_id") @db.Uuid
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  step      BasisStep
  /// As entered on the quotation, in its own currency.
  amount    Decimal   @db.Decimal(14, 2)
  currency  String    @db.Char(3)
  /// In the order's currency, at the rate when the quotation was saved.
  cost      Decimal   @db.Decimal(14, 2)
  fxRate    Decimal?  @map("fx_rate") @db.Decimal(18, 8)
  note      String?   @db.VarChar(200)

  @@unique([orderId, step])
  @@index([companyId])
  @@map("order_costs")
}

/// One step of the order checklist (see @kebo/shared workflows/order).
/// Every move of an order between stages, with who and why.
model OrderStageChange {
  id        String      @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String      @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company     @relation(fields: [companyId], references: [id])
  orderId   String      @map("order_id") @db.Uuid
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStage OrderStage? @map("from_stage")
  toStage   OrderStage  @map("to_stage")
  note      String?
  /// Moved although there was a warning (no deposit, money still due).
  confirmed Boolean     @default(false)
  byId      String?     @map("by") @db.Uuid
  by        User?       @relation(fields: [byId], references: [id])
  at        DateTime    @default(now()) @db.Timestamptz

  @@index([orderId, at])
  @@index([companyId])
  @@map("order_stage_changes")
}

// ============================================================================
// Money: payments in (customer) and out (factory), invoices
// ============================================================================

/// The customer's instalments for an order (deposit, balance, or more). They add
/// up to the order total; money received pays the earliest first.
model PaymentPlanItem {
  id        String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id])
  orderId   String    @map("order_id") @db.Uuid
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label     String    @db.VarChar(80)
  amount    Decimal   @db.Decimal(14, 2)
  /// Null until known (a balance before shipment is dated when the ship date is).
  dueOn     DateTime? @map("due_on") @db.Date
  sortOrder Int       @default(0) @map("sort_order")

  @@index([orderId])
  @@index([dueOn])
  @@index([companyId])
  @@map("payment_plan_items")
}

/// Money we sent a factory for an order, in the currency we paid in.
model FactoryPayment {
  id           String        @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId    String        @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company      Company       @relation(fields: [companyId], references: [id])
  orderId      String        @map("order_id") @db.Uuid
  order        Order         @relation(fields: [orderId], references: [id])
  factoryId    String        @map("factory_id") @db.Uuid
  factory      Factory       @relation(fields: [factoryId], references: [id])
  kind         PaymentKind   @default(deposit)
  amount       Decimal       @db.Decimal(14, 2)
  currency     String        @db.Char(3)
  /// Units of `currency` per one unit of the order's currency when it was paid (CNY 7.10 per USD).
  rate         Decimal       @db.Decimal(24, 14)
  paidOn       DateTime      @map("paid_on") @db.Date
  method       PaymentMethod @default(bank_transfer)
  /// Who in our team paid it.
  paidById     String?       @map("paid_by") @db.Uuid
  paidBy       User?         @relation("FactoryPaymentPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  reference    String?       @db.VarChar(120)
  note         String?
  /// Which of our accounts the money moved through (cash, a bank, a wallet).
  accountId    String?       @map("account_id") @db.Uuid
  account      MoneyAccount? @relation(fields: [accountId], references: [id])
  /// A photo or PDF proving the payment (bank slip, transfer screenshot).
  fileKey      String?       @map("file_key")
  fileName     String?       @map("file_name") @db.VarChar(255)
  fileType     String?       @map("file_type") @db.VarChar(150)
  fileSize     Int?          @map("file_size")
  recordedById String        @map("recorded_by") @db.Uuid
  recordedBy   User          @relation("FactoryPaymentRecorder", fields: [recordedById], references: [id])
  voidedAt     DateTime?     @map("voided_at") @db.Timestamptz
  voidReason   String?       @map("void_reason")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([orderId])
  @@index([factoryId])
  @@index([paidOn])
  @@index([accountId])
  @@index([companyId])
  @@map("factory_payments")
}

/// A cost: for one order (freight, inspection…) or for the company when orderId
/// is empty (rent, salaries…). Only managers and the super admin see these.
model Expense {
  id           String        @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId    String        @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company      Company       @relation(fields: [companyId], references: [id])
  orderId      String?       @map("order_id") @db.Uuid
  order        Order?        @relation(fields: [orderId], references: [id])
  /// Who it was spent on (a dinner, a ticket to visit them…); for a deal or an order always its customer. Empty: the company's own cost.
  customerId   String?       @map("customer_id") @db.Uuid
  customer     Customer?     @relation(fields: [customerId], references: [id])
  /// The deal it was spent on (a trip to check products, samples…), won or lost; for an order always its deal.
  inquiryId    String?       @map("inquiry_id") @db.Uuid
  inquiry      Inquiry?      @relation(fields: [inquiryId], references: [id])
  /// The factory visited or paid for (a trip to check its products, an inspection there).
  factoryId    String?       @map("factory_id") @db.Uuid
  factory      Factory?      @relation(fields: [factoryId], references: [id])
  /// See EXPENSE_CATEGORIES in @kebo/shared.
  category     String        @db.VarChar(30)
  description  String        @db.VarChar(200)
  amount       Decimal       @db.Decimal(14, 2)
  currency     String        @db.Char(3)
  /// Units of `currency` per one unit of the main currency when it was spent (14 decimals, so a
  /// PKR company's 1/280 for USD stays exact enough: USD 100,000 is PKR 28,000,000.00).
  rate         Decimal       @db.Decimal(24, 14)
  spentOn      DateTime      @map("spent_on") @db.Date
  paidById     String?       @map("paid_by") @db.Uuid
  paidBy       User?         @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  reference    String?       @db.VarChar(120)
  note         String?
  /// A photo or PDF of the receipt or ticket.
  receiptKey   String?       @map("receipt_key")
  receiptName  String?       @map("receipt_name") @db.VarChar(255)
  receiptType  String?       @map("receipt_type") @db.VarChar(150)
  receiptSize  Int?          @map("receipt_size")
  /// Which of our accounts the money moved through (cash, a bank, a wallet).
  accountId    String?       @map("account_id") @db.Uuid
  account      MoneyAccount? @relation(fields: [accountId], references: [id])
  recordedById String        @map("recorded_by") @db.Uuid
  recordedBy   User          @relation("ExpenseRecorder", fields: [recordedById], references: [id])
  voidedAt     DateTime?     @map("voided_at") @db.Timestamptz
  voidReason   String?       @map("void_reason")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([orderId])
  @@index([customerId])
  @@index([inquiryId])
  @@index([factoryId])
  @@index([spentOn])
  @@index([accountId])
  @@index([companyId])
  @@map("expenses")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId    String        @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company      Company       @relation(fields: [companyId], references: [id])
  kind         PaymentKind
  orderId      String        @map("order_id") @db.Uuid
  order        Order         @relation(fields: [orderId], references: [id])
  /// Incoming: the customer who paid.
  customerId   String?       @map("customer_id") @db.Uuid
  customer     Customer?     @relation(fields: [customerId], references: [id])
  /// What arrived from the customer.
  amount       Decimal       @db.Decimal(14, 2)
  /// Taken by banks on the way; still counts towards settling the amount due.
  bankCharges  Decimal       @default(0) @map("bank_charges") @db.Decimal(14, 2)
  currency     String        @db.Char(3)
  paidOn       DateTime      @map("paid_on") @db.Date
  method       PaymentMethod @default(bank_transfer)
  reference    String?       @db.VarChar(120)
  note         String?
  /// Which of our accounts the money moved through (cash, a bank, a wallet).
  accountId    String?       @map("account_id") @db.Uuid
  account      MoneyAccount? @relation(fields: [accountId], references: [id])
  /// A photo or PDF proving the payment (bank slip, transfer screenshot).
  fileKey      String?       @map("file_key")
  fileName     String?       @map("file_name") @db.VarChar(255)
  fileType     String?       @map("file_type") @db.VarChar(150)
  fileSize     Int?          @map("file_size")
  recordedById String        @map("recorded_by") @db.Uuid
  recordedBy   User          @relation("PaymentRecorder", fields: [recordedById], references: [id])
  voidedAt     DateTime?     @map("voided_at") @db.Timestamptz
  voidReason   String?       @map("void_reason")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([orderId])
  @@index([paidOn])
  @@index([accountId])
  @@index([companyId])
  @@map("payments")
}

// ============================================================================
// Shipping: a shipment (one or more per order) and its packing list
// ============================================================================

// ============================================================================
// Cash book: where our money is kept, and money moved between accounts
// ============================================================================

/**
 * A place money is kept, in one currency: an office cash box, a bank account, a wallet.
 */
model MoneyAccount {
  id             String           @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId      String           @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company        Company          @relation(fields: [companyId], references: [id])
  name           String           @db.VarChar(80)
  kind           MoneyAccountKind @default(bank)
  currency       String           @db.Char(3)
  /// What was in it on `openingOn`; movements from that day on are added.
  openingBalance Decimal          @default(0) @map("opening_balance") @db.Decimal(14, 2)
  openingOn      DateTime         @map("opening_on") @db.Date
  note           String?
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  payments        Payment[]
  factoryPayments FactoryPayment[]
  expenses        Expense[]
  transfersOut    MoneyTransfer[]  @relation("TransferFrom")
  transfersIn     MoneyTransfer[]  @relation("TransferTo")

  @@unique([companyId, name])
  @@map("money_accounts")
}

/**
 * Money moved between two of our accounts: cash paid into the bank, dollars changed into rupees.
 */
model MoneyTransfer {
  id            String       @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId     String       @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company       Company      @relation(fields: [companyId], references: [id])
  fromAccountId String       @map("from_account_id") @db.Uuid
  fromAccount   MoneyAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId   String       @map("to_account_id") @db.Uuid
  toAccount     MoneyAccount @relation("TransferTo", fields: [toAccountId], references: [id])
  /// Left the first account (its currency) and arrived in the second (its currency).
  amountOut     Decimal      @map("amount_out") @db.Decimal(14, 2)
  amountIn      Decimal      @map("amount_in") @db.Decimal(14, 2)
  transferredOn DateTime     @map("transferred_on") @db.Date
  reference     String?      @db.VarChar(120)
  note          String?
  recordedById  String       @map("recorded_by") @db.Uuid
  recordedBy    User         @relation("TransferRecorder", fields: [recordedById], references: [id])
  voidedAt      DateTime?    @map("voided_at") @db.Timestamptz
  voidReason    String?      @map("void_reason")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([transferredOn])
  @@index([companyId])
  @@map("money_transfers")
}

// ============================================================================
// Insights: monthly sales targets, and each person's reminders done or snoozed
// ============================================================================

/**
 * What the company aims to sell in a month (orders won), in the main currency then.
 */
model SalesTarget {
  /// YYYY-MM
  month       String   @db.Char(7)
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId   String   @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id])
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @db.Char(3)
  updatedById String?  @map("updated_by") @db.Uuid
  updatedBy   User?    @relation("TargetUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([companyId, month])
  @@map("sales_targets")
}

/**
 * A reminder a person marked done or put off. Reminders themselves are worked out from the data each time.
 */
model ReminderState {
  userId       String    @map("user_id") @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId    String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company      Company   @relation(fields: [companyId], references: [id])
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What it is about, e.g. "pay:<instalment id>" or "quote-expiring:<revision id>".
  key          String    @db.VarChar(120)
  snoozedUntil DateTime? @map("snoozed_until") @db.Date
  doneAt       DateTime? @map("done_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@id([userId, key])
  @@index([companyId])
  @@map("reminder_states")
}

// ============================================================================
// Platform: the companies using the app, their plans and payments, client
// inquiries (leads), platform admins. Not visible to company connections
// (the kebo_app role has no access to these tables).
// ============================================================================

/// client: a paying company; demo: made by the platform admin to try it (a few days); trial: self sign-up.
enum CompanyKind {
  client
  demo
  trial
}

/// active: normal; read_only: can look but not change; off: nobody can sign in; deleted: data removed, name held.
enum CompanyStatus {
  active
  read_only
  off
  deleted
}

enum LeadStatus {
  new
  contacted
  demo
  client
  lost
}

enum LeadSource {
  form
  sign_up
  manual
  /// The "Questions?" form on the marketing site.
  contact
}

/// One company using the app. Every company row elsewhere carries its id.
model Company {
  id                String        @id @default(uuid()) @db.Uuid
  /// Short name: the future address (name.rfq…); a-z, 0-9 and "-".
  slug              String        @unique @db.VarChar(30)
  name              String        @db.VarChar(120)
  kind              CompanyKind   @default(client)
  status            CompanyStatus @default(active)
  /// Why it is read-only or off ("Demo ended", "Payment overdue", "Switched off by the platform admin").
  statusReason      String?       @map("status_reason") @db.VarChar(200)
  /// Set when the platform admin changed the status by hand: the automatic rules leave it alone.
  statusManual      Boolean       @default(false) @map("status_manual")
  planId            String?       @map("plan_id") @db.Uuid
  plan              Plan?         @relation(fields: [planId], references: [id])
  startsOn          DateTime      @default(dbgenerated("CURRENT_DATE")) @map("starts_on") @db.Date
  /// Paid until (clients): after it the company is overdue.
  renewsOn          DateTime?     @map("renews_on") @db.Date
  /// Demos and trials: when it ends.
  endsAt            DateTime?     @map("ends_at") @db.Timestamptz
  /// Demo: "ends tomorrow" emails sent for this end date.
  endingNoticeFor   DateTime?     @map("ending_notice_for") @db.Timestamptz
  /// The previous short name, kept working until previousSlugUntil after a rename.
  previousSlug      String?       @map("previous_slug") @db.VarChar(30)
  previousSlugUntil DateTime?     @map("previous_slug_until") @db.Timestamptz
  contactName       String?       @map("contact_name") @db.VarChar(120)
  contactEmail      String?       @map("contact_email") @db.VarChar(254)
  notes             String?
  lastActiveAt      DateTime?     @map("last_active_at") @db.Timestamptz
  /// The company website form's key: the form sends it, and it decides the company (Settings → Website form).
  formKey           String        @unique @default(dbgenerated("replace(((gen_random_uuid())::text || (gen_random_uuid())::text), '-'::text, ''::text)")) @map("form_key") @db.VarChar(64)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  subscriptionPayments SubscriptionPayment[]
  leads                Lead[]
  platformLog          PlatformLog[]

  roles               Role[]
  users               User[]
  sessions            Session[]
  signIns             SignIn[]
  deviceTokens        DeviceToken[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  settings            Setting[]
  counters            Counter[]
  customers           Customer[]
  contacts            Contact[]
  factories           Factory[]
  inquiries           Inquiry[]
  requestedItems      RequestedItem[]
  inquiryStageChanges InquiryStageChange[]
  inquiryAssignments  InquiryAssignment[]
  inquiryNotes        InquiryNote[]
  attachments         Attachment[]
  factoryQuotes       FactoryQuote[]
  factoryQuoteLines   FactoryQuoteLine[]
  quotations          Quotation[]
  quotationRevisions  QuotationRevision[]
  quotationOptions    QuotationOption[]
  optionCosts         OptionCost[]
  orderCosts          OrderCost[]
  quoteLines          QuoteLine[]
  orders              Order[]
  orderLines          OrderLine[]
  orderStageChanges   OrderStageChange[]
  paymentPlanItems    PaymentPlanItem[]
  factoryPayments     FactoryPayment[]
  expenses            Expense[]
  payments            Payment[]
  moneyAccounts       MoneyAccount[]
  moneyTransfers      MoneyTransfer[]
  salesTargets        SalesTarget[]
  reminderStates      ReminderState[]

  @@map("companies")
}

/// What a company pays for and what it may use.
model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(60)
  description  String?  @db.VarChar(300)
  /// Price per period in minor units (cents) of currency.
  priceMinor   Int      @default(0) @map("price_minor")
  currency     String   @default("USD") @db.Char(3)
  /// month or year
  period       String   @default("month") @db.VarChar(10)
  /// Null: no limit.
  maxUsers     Int?     @map("max_users")
  maxStorageMb Int?     @map("max_storage_mb")
  /// Features switched on (@kebo/shared PLAN_FEATURES).
  features     String[] @default([])
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  companies Company[]

  @@map("plans")
}

/// A payment from a company, recorded by hand.
model SubscriptionPayment {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  amountMinor Int      @map("amount_minor")
  currency    String   @db.Char(3)
  paidOn      DateTime @map("paid_on") @db.Date
  /// The company's new "paid until" date.
  paidUntil   DateTime @map("paid_until") @db.Date
  note        String?  @db.VarChar(300)
  recordedBy  String?  @map("recorded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([companyId])
  @@map("subscription_payments")
}

/// Someone who asked about the app (demo request form, a self sign-up, or added by hand).
model Lead {
  id          String     @id @default(uuid()) @db.Uuid
  companyName String     @map("company_name") @db.VarChar(160)
  name        String     @db.VarChar(120)
  email       String     @db.VarChar(254)
  phone       String?    @db.VarChar(40)
  country     String?    @db.VarChar(80)
  teamSize    String?    @map("team_size") @db.VarChar(20)
  message     String?
  source      LeadSource @default(form)
  status      LeadStatus @default(new)
  lostReason  String?    @map("lost_reason") @db.VarChar(300)
  followUpOn  DateTime?  @map("follow_up_on") @db.Date
  /// The demo or company made for them.
  companyId   String?    @map("company_id") @db.Uuid
  company     Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ip          String?    @db.VarChar(64)
  /// Where they came from, in one word for grouping: a campaign's source, the site that sent them, or "direct".
  channel     String?    @db.VarChar(80)
  /// The details: utm_source / medium / campaign, the referring site, the page and the button.
  origin      Json?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  notes LeadNote[]

  @@index([status])
  @@index([createdAt])
  @@index([channel])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  text      String
  byId      String?  @map("by_id") @db.Uuid
  byName    String?  @map("by_name") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([leadId])
  @@map("lead_notes")
}

/// The people who run the platform (not part of any company).
model PlatformAdmin {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(254)
  name          String    @db.VarChar(120)
  passwordHash  String    @map("password_hash")
  isActive      Boolean   @default(true) @map("is_active")
  failedLogins  Int       @default(0) @map("failed_logins")
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz
  totpSecret    String?   @map("totp_secret")
  totpEnabledAt DateTime? @map("totp_enabled_at") @db.Timestamptz
  totpLastStep  Int?      @map("totp_last_step")
  recoveryCodes String[]  @default([]) @map("recovery_codes")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions PlatformSession[]

  @@map("platform_admins")
}

model PlatformSession {
  id             String        @id @default(uuid()) @db.Uuid
  adminId        String        @map("admin_id") @db.Uuid
  admin          PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt     DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz
  pendingTwoStep Boolean       @default(false) @map("pending_two_step")
  ip             String?       @db.VarChar(64)
  userAgent      String?       @map("user_agent") @db.VarChar(300)

  @@index([adminId])
  @@map("platform_sessions")
}

/// What platform admins (and the automatic rules) did: companies made, switched off, opened, payments…
model PlatformLog {
  id        String   @id @default(uuid()) @db.Uuid
  /// Null: done by the automatic rules.
  adminId   String?  @map("admin_id") @db.Uuid
  adminName String?  @map("admin_name") @db.VarChar(120)
  action    String   @db.VarChar(60)
  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leadId    String?  @map("lead_id") @db.Uuid
  summary   String
  details   Json?
  at        DateTime @default(now()) @db.Timestamptz

  @@index([companyId, at])
  @@index([at])
  @@map("platform_log")
}

/// Self sign-ups waiting for their email to be checked.
model SignUp {
  id           String    @id @default(uuid()) @db.Uuid
  companyName  String    @map("company_name") @db.VarChar(160)
  slug         String    @db.VarChar(30)
  name         String    @db.VarChar(120)
  email        String    @db.VarChar(254)
  passwordHash String    @map("password_hash")
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz
  companyId    String?   @map("company_id") @db.Uuid
  ip           String?   @db.VarChar(64)
  /// Where they came from (passed on to the lead).
  origin       Json?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@map("sign_ups")
}

/// The marketing site's words, one row per page ("marketing"): what is being edited, and what visitors see.
model SiteContent {
  key         String    @id @db.VarChar(40)
  draft       Json
  published   Json?
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy   String?   @map("updated_by") @db.VarChar(120)

  @@map("site_content")
}

/// Marketing site visits per day and channel, counted without cookies.
model SiteVisit {
  day      DateTime @db.Date
  channel  String   @db.VarChar(80)
  views    Int      @default(0)
  visitors Int      @default(0)

  @@id([day, channel])
  @@map("site_visits")
}

/// One visitor seen on a day (a one-way hash of the day, address and browser), so each counts once a day. Kept two days.
model SiteVisitorMark {
  day  DateTime @db.Date
  hash String   @db.Char(32)

  @@id([day, hash])
  @@map("site_visitor_marks")
}

/// One-off facts about this database that must survive a backup and restore (pg_dump keeps table rows,
/// not database settings): e.g. "utc_timestamps", the stored times were moved to UTC. Platform table.
model DatabaseMarker {
  key  String   @id @db.VarChar(60)
  note String
  at   DateTime @default(now()) @db.Timestamptz

  @@map("database_markers")
}
