/// What a company pays for and what it may use.
model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(60)
  description  String?  @db.VarChar(300)
  /// Price per period in minor units (cents) of currency.
  priceMinor   Int      @default(0) @map("price_minor")
  currency     String   @default("USD") @db.Char(3)
  /// month or year
  period       String   @default("month") @db.VarChar(10)
  /// Null: no limit.
  maxUsers     Int?     @map("max_users")
  maxStorageMb Int?     @map("max_storage_mb")
  /// Features switched on (@kebo/shared PLAN_FEATURES).
  features     String[] @default([])
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  companies Company[]

  @@map("plans")
}

/// A payment from a company, recorded by hand.
model SubscriptionPayment {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  amountMinor Int      @map("amount_minor")
  currency    String   @db.Char(3)
  paidOn      DateTime @map("paid_on") @db.Date
  /// The company's new "paid until" date.
  paidUntil   DateTime @map("paid_until") @db.Date
  note        String?  @db.VarChar(300)
  recordedBy  String?  @map("recorded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([companyId])
  @@map("subscription_payments")
}

/// Someone who asked about the app (demo request form, a self sign-up, or added by hand).
model Lead {
  id          String     @id @default(uuid()) @db.Uuid
  companyName String     @map("company_name") @db.VarChar(160)
  name        String     @db.VarChar(120)
  email       String     @db.VarChar(254)
  phone       String?    @db.VarChar(40)
  country     String?    @db.VarChar(80)
  teamSize    String?    @map("team_size") @db.VarChar(20)
  message     String?
  source      LeadSource @default(form)
  status      LeadStatus @default(new)
  lostReason  String?    @map("lost_reason") @db.VarChar(300)
  followUpOn  DateTime?  @map("follow_up_on") @db.Date
  /// The demo or company made for them.
  companyId   String?    @map("company_id") @db.Uuid
  company     Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ip          String?    @db.VarChar(64)
  /// Where they came from, in one word for grouping: a campaign's source, the site that sent them, or "direct".
  channel     String?    @db.VarChar(80)
  /// The details: utm_source / medium / campaign, the referring site, the page and the button.
  origin      Json?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  notes LeadNote[]

  @@index([status])
  @@index([createdAt])
  @@index([channel])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  text      String
  byId      String?  @map("by_id") @db.Uuid
  byName    String?  @map("by_name") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([leadId])
  @@map("lead_notes")
}

/// The people who run the platform (not part of any company).
model PlatformAdmin {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(254)
  name          String    @db.VarChar(120)
  passwordHash  String    @map("password_hash")
  isActive      Boolean   @default(true) @map("is_active")
  failedLogins  Int       @default(0) @map("failed_logins")
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz
  totpSecret    String?   @map("totp_secret")
  totpEnabledAt DateTime? @map("totp_enabled_at") @db.Timestamptz
  totpLastStep  Int?      @map("totp_last_step")
  recoveryCodes String[]  @default([]) @map("recovery_codes")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions PlatformSession[]

  @@map("platform_admins")
}

model PlatformSession {
  id             String        @id @default(uuid()) @db.Uuid
  adminId        String        @map("admin_id") @db.Uuid
  admin          PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt     DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz
  pendingTwoStep Boolean       @default(false) @map("pending_two_step")
  ip             String?       @db.VarChar(64)
  userAgent      String?       @map("user_agent") @db.VarChar(300)

  @@index([adminId])
  @@map("platform_sessions")
}

/// What platform admins (and the automatic rules) did: companies made, switched off, opened, payments…
model PlatformLog {
  id        String   @id @default(uuid()) @db.Uuid
  /// Null: done by the automatic rules.
  adminId   String?  @map("admin_id") @db.Uuid
  adminName String?  @map("admin_name") @db.VarChar(120)
  action    String   @db.VarChar(60)
  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leadId    String?  @map("lead_id") @db.Uuid
  summary   String
  details   Json?
  at        DateTime @default(now()) @db.Timestamptz

  @@index([companyId, at])
  @@index([at])
  @@map("platform_log")
}

/// Self sign-ups waiting for their email to be checked.
model SignUp {
  id           String    @id @default(uuid()) @db.Uuid
  companyName  String    @map("company_name") @db.VarChar(160)
  slug         String    @db.VarChar(30)
  name         String    @db.VarChar(120)
  email        String    @db.VarChar(254)
  passwordHash String    @map("password_hash")
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz
  companyId    String?   @map("company_id") @db.Uuid
  ip           String?   @db.VarChar(64)
  /// Where they came from (passed on to the lead).
  origin       Json?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@map("sign_ups")
}

/// The marketing site's words, one row per page ("marketing"): what is being edited, and what visitors see.
model SiteContent {
  key         String    @id @db.VarChar(40)
  draft       Json
  published   Json?
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy   String?   @map("updated_by") @db.VarChar(120)

  @@map("site_content")
}

/// Marketing site visits per day and channel, counted without cookies.
model SiteVisit {
  day      DateTime @db.Date
  channel  String   @db.VarChar(80)
  views    Int      @default(0)
  visitors Int      @default(0)

  @@id([day, channel])
  @@map("site_visits")
}

/// One visitor seen on a day (a one-way hash of the day, address and browser), so each counts once a day. Kept two days.
model SiteVisitorMark {
  day  DateTime @db.Date
  hash String   @db.Char(32)

  @@id([day, hash])
  @@map("site_visitor_marks")
}

/// One-off facts about this database that must survive a backup and restore (pg_dump keeps table rows,
/// not database settings): e.g. "utc_timestamps", the stored times were moved to UTC. Platform table.
model DatabaseMarker {
  key  String   @id @db.VarChar(60)
  note String
  at   DateTime @default(now()) @db.Timestamptz

  @@map("database_markers")
}

// ============================================================================
// Insights data: three calculated tables (never typed by people)
// ============================================================================

/// One ready-made row per order for Insights, worked out only by the shared rules (orderPosition, orderMoney,
/// the live plan, shippedOnOf, the ready dates) in FactsService. Refreshed when anything of the order changes
/// (facts_queue, filled by database triggers) and rebuilt every night; it can always be thrown away and made
/// again. Money in the main currency (`main_currency`) at the order's own rate.
model OrderFact {
  orderId            String         @id @map("order_id") @db.Uuid
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId          String         @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inquiryId          String         @map("inquiry_id") @db.Uuid
  inquiry            Inquiry        @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  customerId         String         @map("customer_id") @db.Uuid
  customer           Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  handledBy          String?        @map("handled_by") @db.Uuid
  handler            User?          @relation("OrderFactHandledBy", fields: [handledBy], references: [id], onDelete: SetNull)
  country            String         @db.Char(2)
  channel            InquiryChannel
  category           String         @db.VarChar(120)
  status             OrderStatus
  stage              OrderStage
  orderedOn          DateTime       @map("ordered_on") @db.Date
  shipBy             DateTime?      @map("ship_by") @db.Date
  readyOn            DateTime?      @map("ready_on") @db.Date
  shippedOn          DateTime?      @map("shipped_on") @db.Date
  deliveredOn        DateTime?      @map("delivered_on") @db.Date
  closedOn           DateTime?      @map("closed_on") @db.Date
  /// The order's own currency, and the main currency the figures below are in.
  currency           String         @db.Char(3)
  mainCurrency       String         @map("main_currency") @db.Char(3)
  /// False: no rate to the main currency (the money figures are 0 and the order is listed as missing a rate).
  rateKnown          Boolean        @map("rate_known")
  totalMain          Decimal        @map("total_main") @db.Decimal(16, 2)
  /// The part of the total whose lines have a cost (profit and margin are on it alone).
  costedMain         Decimal        @map("costed_main") @db.Decimal(16, 2)
  /// Goods and the planned costs to reach the basis sold on.
  costMain           Decimal        @map("cost_main") @db.Decimal(16, 2)
  profitQuoteMain    Decimal        @map("profit_quote_main") @db.Decimal(16, 2)
  profitExpectedMain Decimal        @map("profit_expected_main") @db.Decimal(16, 2)
  marginQuote        Decimal?       @map("margin_quote") @db.Decimal(8, 1)
  margin             Decimal?       @db.Decimal(8, 1)
  /// Every live expense we bear on the order.
  expensesMain       Decimal        @map("expenses_main") @db.Decimal(16, 2)
  /// What went beyond the plan: profit on the quote less profit now expected.
  costsOverPlanMain  Decimal        @map("costs_over_plan_main") @db.Decimal(16, 2)
  receivedMain       Decimal        @map("received_main") @db.Decimal(16, 2)
  dueMain            Decimal        @map("due_main") @db.Decimal(16, 2)
  /// Late on the plan on the day it was worked out (readers age `open_parts` against today).
  overdueMain        Decimal        @map("overdue_main") @db.Decimal(16, 2)
  /// What is still open, part by part: [{ "dueOn": "2026-11-30" | null, "open": "1200.00" }] (main currency).
  openParts          Json           @default("[]") @map("open_parts")
  paidInFullOn       DateTime?      @map("paid_in_full_on") @db.Date
  /// Paid in full with every dated part settled by its due date (null until paid in full).
  paidOnTime         Boolean?       @map("paid_on_time")
  /// Shipped by the ship-by date (null: not shipped or no ship-by).
  onTime             Boolean?       @map("on_time")
  daysQuoteToOrder   Int?           @map("days_quote_to_order")
  daysToShip         Int?           @map("days_to_ship")
  computedAt         DateTime       @default(now()) @map("computed_at") @db.Timestamptz

  @@index([companyId, orderedOn])
  @@index([customerId])
  @@index([inquiryId])
  @@index([handledBy])
  @@map("order_facts")
}

/// One ready-made row per inquiry (not deleted) for the funnel and the people, worked out by the shared rules.
model InquiryFact {
  inquiryId        String         @id @map("inquiry_id") @db.Uuid
  inquiry          Inquiry        @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId        String         @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId       String         @map("customer_id") @db.Uuid
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  handledBy        String?        @map("handled_by") @db.Uuid
  handler          User?          @relation("InquiryFactHandledBy", fields: [handledBy], references: [id], onDelete: SetNull)
  channel          InquiryChannel
  country          String         @db.Char(2)
  category         String         @db.VarChar(120)
  stage            InquiryStage
  /// The company's day it came in (APP_TIME_ZONE).
  receivedOn       DateTime       @map("received_on") @db.Date
  firstQuoteOn     DateTime?      @map("first_quote_on") @db.Date
  /// At least one factory offer came in.
  gotPrices        Boolean        @map("got_prices")
  /// The latest sent quotation at its accepted option, else its lowest, at today's Settings rate (null: none sent).
  quotedValueMain  Decimal?       @map("quoted_value_main") @db.Decimal(16, 2)
  mainCurrency     String         @map("main_currency") @db.Char(3)
  /// open | won | lost
  outcome          String         @db.VarChar(4)
  lostReason       LostReason?    @map("lost_reason")
  closedOn         DateTime?      @map("closed_on") @db.Date
  daysToFirstQuote Int?           @map("days_to_first_quote")
  daysToClose      Int?           @map("days_to_close")
  computedAt       DateTime       @default(now()) @map("computed_at") @db.Timestamptz

  @@index([companyId, receivedOn])
  @@index([companyId, closedOn])
  @@index([customerId])
  @@index([handledBy])
  @@map("inquiry_facts")
}

/// One ready-made row per order × factory (the factories its lines are bought from): what we owe it
/// (factoryPosition), its plan's open parts, its ready date against the promise, its offers on the deal.
model FactoryOrderFact {
  orderId       String      @map("order_id") @db.Uuid
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  factoryId     String      @map("factory_id") @db.Uuid
  factory       Factory     @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId     String      @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status        OrderStatus
  orderedOn     DateTime    @map("ordered_on") @db.Date
  /// The factory's currency; null when the order owes it in more than one (then only the main figures).
  currency      String?     @db.Char(3)
  owed          Decimal?    @db.Decimal(16, 2)
  paid          Decimal?    @db.Decimal(16, 2)
  toPay         Decimal?    @map("to_pay") @db.Decimal(16, 2)
  mainCurrency  String      @map("main_currency") @db.Char(3)
  owedMain      Decimal     @map("owed_main") @db.Decimal(16, 2)
  paidMain      Decimal     @map("paid_main") @db.Decimal(16, 2)
  toPayMain     Decimal     @map("to_pay_main") @db.Decimal(16, 2)
  /// Its plan's open parts: [{ "dueOn": "2026-11-30" | null, "open": "1200.00" }] (main currency).
  openParts     Json        @default("[]") @map("open_parts")
  readyPromised DateTime?   @map("ready_promised") @db.Date
  readyActual   DateTime?   @map("ready_actual") @db.Date
  daysLate      Int?        @map("days_late")
  onTime        Boolean?    @map("on_time")
  /// Offers this factory sent on the order's deal, and whether the order was bought on one of them.
  offersSent    Int         @map("offers_sent")
  offerWon      Boolean     @map("offer_won")
  /// Claims on the order (claims name no factory yet: each of the order's factories carries them).
  claims        Int
  computedAt    DateTime    @default(now()) @map("computed_at") @db.Timestamptz

  @@id([orderId, factoryId])
  @@index([companyId, orderedOn])
  @@index([factoryId])
  @@map("factory_order_facts")
}

/// What the calculated tables still have to catch up on: database triggers on the tables they are worked out
/// from add the order or inquiry here (kind "all": the whole company, e.g. after the rates changed), and
/// FactsService works them off (after each change through the API, before every read, and in the worker).
model FactsQueue {
  /// The company this row belongs to (row-level security keeps companies apart; filled from the row changed).
  companyId String   @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// order | inquiry | all
  kind      String   @db.VarChar(10)
  entityId  String   @map("entity_id") @db.Uuid
  /// Moves on each time the row is queued again, so a row queued while it was being worked off stays.
  seq       BigInt   @default(autoincrement())
  queuedAt  DateTime @default(now()) @map("queued_at") @db.Timestamptz

  @@id([companyId, kind, entityId])
  @@map("facts_queue")
}

/// Money received or an expense a person added for a manager to approve. Nothing here counts: no payment, expense
/// or money figure changes until it is approved, which records it through the usual endpoint's code as the approver.
model MoneySubmission {
  id            String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId     String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company       Company   @relation(fields: [companyId], references: [id])
  /// payment (money received from the customer) | expense
  kind          String    @db.VarChar(10)
  /// The order it is on (always for a payment; for an expense when it is on one).
  orderId       String?   @map("order_id") @db.Uuid
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Exactly what the usual endpoint takes (paymentInput / expenseInput), as checked when it was sent.
  body          Json
  /// The bank slip or receipt photo, until it moves to the payment or expense made on approval.
  fileKey       String?   @map("file_key")
  fileName      String?   @map("file_name") @db.VarChar(255)
  fileType      String?   @map("file_type") @db.VarChar(150)
  fileSize      Int?      @map("file_size")
  /// pending | approved | sent_back | withdrawn
  status        String    @default("pending") @db.VarChar(10)
  submittedById String    @map("submitted_by") @db.Uuid
  submittedBy   User      @relation("SubmissionSubmittedBy", fields: [submittedById], references: [id])
  submittedAt   DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  decidedById   String?   @map("decided_by") @db.Uuid
  decidedBy     User?     @relation("SubmissionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz
  /// Why it was sent back.
  reason        String?   @db.VarChar(500)
  /// The payment or expense made when it was approved.
  createdId     String?   @map("created_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId, status])
  @@index([orderId])
  @@index([submittedById])
  @@map("money_submissions")
}

/// A note or call log on an order, a customer or a factory (exactly one of them). Inquiries keep theirs in
/// inquiry_notes, with the same fields.
model RecordNote {
  id         String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId  String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company    Company   @relation(fields: [companyId], references: [id])
  orderId    String?   @map("order_id") @db.Uuid
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String?   @map("customer_id") @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  factoryId  String?   @map("factory_id") @db.Uuid
  factory    Factory?  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  /// note | call | visit | whatsapp | email (see NOTE_KINDS)
  kind       String    @default("note") @db.VarChar(10)
  body       String
  /// The customer's contact it was with (orders and customers; factories have no contact list).
  contactId  String?   @map("contact_id") @db.Uuid
  contact    Contact?  @relation("RecordNoteContact", fields: [contactId], references: [id], onDelete: SetNull)
  /// When it happened (the call, the visit); when it was written for a plain note.
  at         DateTime  @default(now()) @db.Timestamptz
  authorId   String    @map("author_id") @db.Uuid
  author     User      @relation("RecordNoteAuthor", fields: [authorId], references: [id])
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// Last changed by its author (only within 24 hours of writing it).
  editedAt   DateTime? @map("edited_at") @db.Timestamptz

  @@index([orderId, at])
  @@index([customerId, at])
  @@index([factoryId, at])
  @@index([companyId])
  @@map("record_notes")
}

/// A planned call, visit or meeting for someone (Home's "Follow-ups today"), on at most one record: an
/// inquiry, an order, a customer or a factory (none: a general one). The worker reminds the person it is
/// for at the start of the day it is due and, when it has a time, 30 minutes before.
model FollowUp {
  id          String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId   String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company     Company   @relation(fields: [companyId], references: [id])
  title       String    @db.VarChar(200)
  /// call | visit | meeting | other (see FOLLOW_UP_KINDS)
  kind        String    @default("other") @db.VarChar(10)
  /// The day it is due (the company's calendar day).
  dueOn       DateTime  @map("due_on") @db.Date
  /// The time it is due that day, "HH:MM" in the company's time zone; none: some time that day.
  dueAt       String?   @map("due_at") @db.VarChar(5)
  place       String?   @db.VarChar(160)
  note        String?   @db.VarChar(2000)
  inquiryId   String?   @map("inquiry_id") @db.Uuid
  inquiry     Inquiry?  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  orderId     String?   @map("order_id") @db.Uuid
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId  String?   @map("customer_id") @db.Uuid
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  factoryId   String?   @map("factory_id") @db.Uuid
  factory     Factory?  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  assigneeId  String    @map("assignee_id") @db.Uuid
  assignee    User      @relation("FollowUpAssignee", fields: [assigneeId], references: [id])
  createdById String    @map("created_by") @db.Uuid
  createdBy   User      @relation("FollowUpCreatedBy", fields: [createdById], references: [id])
  doneAt      DateTime? @map("done_at") @db.Timestamptz
  doneById    String?   @map("done_by") @db.Uuid
  doneBy      User?     @relation("FollowUpDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  /// What came of it (said when ticking it done).
  doneNote    String?   @map("done_note") @db.VarChar(2000)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId, assigneeId, doneAt, dueOn])
  @@index([dueOn])
  @@index([inquiryId])
  @@index([orderId])
  @@index([customerId])
  @@index([factoryId])
  @@index([createdById])
  @@map("follow_ups")
}
