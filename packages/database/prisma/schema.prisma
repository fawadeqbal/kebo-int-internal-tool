// Kebo deal tracker: the data model.
//
// Conventions
// - Tables and columns are snake_case in Postgres (@@map / @map); models are PascalCase.
// - Money: Decimal(14,2) columns, always handled as integer minor units in code (@kebo/money).
// - Calendar dates (due, issued, paid) are DATE columns with no time of day.
// - Business records are soft-deleted (deleted_at) so history never disappears.
// - Enum values match @kebo/shared/enums (a test checks they stay in sync).
// - Snapshot JSON columns freeze who a document was for/from when it was sent or issued.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

enum Role {
  admin
  manager
  staff
}

enum InquiryStage {
  new
  sourcing
  quoted
  won
  lost
}

enum InquiryChannel {
  website
  whatsapp
  wechat
  email
  phone
  visit
  other
}

enum Priority {
  low
  normal
  high
  urgent
}

enum LostReason {
  price_too_high
  no_reply
  factory_cannot_supply
  bought_elsewhere
  customer_cancelled
  duplicate_or_spam
  other
}

enum CustomerType {
  company
  individual
}

enum RevisionStatus {
  draft
  sent
  accepted
  rejected
  expired
  superseded
  /// Accepted, but its order was later cancelled.
  void
}

enum LineType {
  goods
  service
  charge
}

enum Incoterm {
  EXW
  FCA
  FAS
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP
}

enum BalanceTerms {
  before_shipment
  against_bl_copy
  after_arrival
  letter_of_credit
}

enum OrderStatus {
  open
  closed
  cancelled
}

/// Confirmed → In production → Shipped → Done, one button at a time (cancelled is the status).
enum OrderStage {
  confirmed
  in_production
  shipped
  done

  @@map("order_stage")
}

enum PaymentKind {
  deposit
  balance
  other
}

enum PaymentMethod {
  bank_transfer
  letter_of_credit
  cash
  cheque
  online
  other
}

// ============================================================================
// Platform: people, sign-in, settings, numbering, audit, notifications
// ============================================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(120)
  email         String    @unique @db.VarChar(254)
  passwordHash  String    @map("password_hash")
  role          Role      @default(staff)
  isActive      Boolean   @default(true) @map("is_active")
  /// Built-in account that records website inquiries; can never sign in.
  isSystem      Boolean   @default(false) @map("is_system")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz
  failedLogins  Int       @default(0) @map("failed_logins")
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz
  /// Two-step sign-in: encrypted authenticator secret; on once totpEnabledAt is set.
  totpSecret    String?   @map("totp_secret")
  totpEnabledAt DateTime? @map("totp_enabled_at") @db.Timestamptz
  totpLastStep  Int?      @map("totp_last_step")
  /// sha256 hashes of unused recovery codes.
  recoveryCodes String[]  @default([]) @map("recovery_codes")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions      Session[]
  devices       DeviceToken[]
  notifications Notification[]
  assignedDeals Inquiry[]          @relation("InquiryAssignee")
  createdDeals  Inquiry[]          @relation("InquiryCreator")
  orderMoves    OrderStageChange[]
  factories     Factory[]          @relation("FactoryOwner")
  factoryPaid   FactoryPayment[]   @relation("FactoryPaymentPaidBy")
  expensesPaid  Expense[]          @relation("ExpensePaidBy")

  @@map("users")
}

/// One row per signed-in browser or phone; the token only carries this id, so sign-out and deactivation end sessions at once.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  userAgent      String?   @map("user_agent") @db.VarChar(300)
  /// Signed in, but the second step (authenticator code) is not done yet.
  pendingTwoStep Boolean   @default(false) @map("pending_two_step")

  devices DeviceToken[]

  @@index([userId])
  @@map("sessions")
}

/// Phones that receive push notifications.
model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String?  @map("session_id") @db.Uuid
  session    Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String   @default("android") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz

  @@index([userId])
  @@map("device_tokens")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(60)
  title     String    @db.VarChar(255)
  body      String?
  link      String?   @db.VarChar(255)
  /// Stops the reminder job sending the same reminder twice.
  dedupeKey String?   @map("dedupe_key") @db.VarChar(200)
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Who changed what, with old and new values.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.Uuid
  summary    String?
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  /// Why the change was made (asked where a change affects others; see @kebo/shared workflows/reasons).
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Company profile, defaults, reminder rules, plan timings: one JSON value per key.
model Setting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}

/// Gap-free yearly counters for document numbers (RFQ-2026-0001, SO-2026-0001…).
model Counter {
  key   String @id @db.VarChar(50)
  value Int    @default(0)

  @@map("counters")
}

// ============================================================================
// Parties: customers (with contacts) and factories
// ============================================================================

model Customer {
  id              String       @id @default(uuid()) @db.Uuid
  type            CustomerType @default(company)
  name            String       @db.VarChar(200)
  /// ISO 3166-1 alpha-2 (e.g. NG, AE): where the goods go. China (CN) means a domestic sale with VAT.
  country         String       @db.Char(2)
  address         String?
  /// Business license / tax number (shown on documents as "Business License Number").
  taxNo           String?      @map("tax_no") @db.VarChar(60)
  /// Registration number (shown on documents as "Reg. Number").
  regNo           String?      @map("reg_no") @db.VarChar(60)
  defaultCurrency String       @default("USD") @map("default_currency") @db.Char(3)
  notes           String?
  createdById     String?      @map("created_by") @db.Uuid
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  contacts  Contact[]
  inquiries Inquiry[]
  orders    Order[]
  payments  Payment[]

  @@index([name])
  @@index([country])
  @@map("customers")
}

model Contact {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String    @db.VarChar(120)
  position   String?   @db.VarChar(80)
  email      String?   @db.VarChar(254)
  phone      String?   @db.VarChar(40)
  whatsapp   String?   @db.VarChar(40)
  wechat     String?   @db.VarChar(80)
  isPrimary  Boolean   @default(false) @map("is_primary")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  inquiries Inquiry[]

  @@index([customerId])
  @@index([email])
  @@index([phone])
  @@index([whatsapp])
  @@map("contacts")
}

model Factory {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(200)
  contactPerson String?   @map("contact_person") @db.VarChar(120)
  phone         String?   @db.VarChar(40)
  wechat        String?   @db.VarChar(80)
  email         String?   @db.VarChar(254)
  address       String?
  bankDetails   String?   @map("bank_details")
  notes         String?
  /// The person in our team who looks after this factory.
  ownerId       String?   @map("owner_id") @db.Uuid
  owner         User?     @relation("FactoryOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById   String?   @map("created_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  quotes   FactoryQuote[]
  payments FactoryPayment[]

  @@index([name])
  @@index([ownerId])
  @@map("factories")
}

// ============================================================================
// Sales: the inquiry (deal) and what the customer asked for
// ============================================================================

model Inquiry {
  id           String         @id @default(uuid()) @db.Uuid
  /// RFQ-2026-0001
  refNo        String         @unique @map("ref_no") @db.VarChar(30)
  customerId   String         @map("customer_id") @db.Uuid
  customer     Customer       @relation(fields: [customerId], references: [id])
  contactId    String?        @map("contact_id") @db.Uuid
  contact      Contact?       @relation(fields: [contactId], references: [id])
  channel      InquiryChannel @default(email)
  category     String         @db.VarChar(120)
  title        String         @db.VarChar(200)
  /// Anything else the customer said: destination port, standards, delivery…
  requirements String?
  priority     Priority       @default(normal)
  requiredBy   DateTime?      @map("required_by") @db.Date
  stage        InquiryStage   @default(new)
  onHold       Boolean        @default(false) @map("on_hold")
  lostReason   LostReason?    @map("lost_reason")
  lostNote     String?        @map("lost_note")
  assigneeId   String?        @map("assignee_id") @db.Uuid
  assignee     User?          @relation("InquiryAssignee", fields: [assigneeId], references: [id])
  createdById  String         @map("created_by") @db.Uuid
  createdBy    User           @relation("InquiryCreator", fields: [createdById], references: [id])
  /// When it was won or lost (turnaround = closedAt − createdAt).
  closedAt     DateTime?      @map("closed_at") @db.Timestamptz
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  items         RequestedItem[]
  stageChanges  InquiryStageChange[]
  assignments   InquiryAssignment[]
  notes         InquiryNote[]
  attachments   Attachment[]
  factoryQuotes FactoryQuote[]
  quotation     Quotation?
  /// At most one order that is not cancelled (partial unique index in the integrity migration).
  orders        Order[]

  @@index([stage])
  @@index([assigneeId])
  @@index([customerId])
  @@index([createdAt])
  @@map("inquiries")
}

model RequestedItem {
  id                     String            @id @default(uuid()) @db.Uuid
  inquiryId              String            @map("inquiry_id") @db.Uuid
  inquiry                Inquiry           @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// A part of another item, split at factory pricing (numbered 3.1, 3.2 under item 3). One level only.
  parentId               String?           @map("parent_id") @db.Uuid
  parent                 RequestedItem?    @relation("ItemParts", fields: [parentId], references: [id], onDelete: Cascade)
  parts                  RequestedItem[]   @relation("ItemParts")
  description            String
  model                  String?           @db.VarChar(120)
  quantity               Decimal           @db.Decimal(12, 2)
  unit                   String            @default("pcs") @db.VarChar(20)
  targetPrice            Decimal?          @map("target_price") @db.Decimal(14, 2)
  sortOrder              Int               @default(0) @map("sort_order")
  /// The factory price line to quote from by default.
  preferredFactoryLineId String?           @map("preferred_factory_line_id") @db.Uuid
  preferredFactoryLine   FactoryQuoteLine? @relation("PreferredLine", fields: [preferredFactoryLineId], references: [id], onDelete: SetNull)

  factoryLines FactoryQuoteLine[] @relation("AnswersItem")
  quoteLines   QuoteLine[]

  @@index([inquiryId])
  @@index([parentId])
  @@map("requested_items")
}

/// Every stage move, automatic or by hand; turnaround and time-in-stage come from here.
model InquiryStageChange {
  id          String        @id @default(uuid()) @db.Uuid
  inquiryId   String        @map("inquiry_id") @db.Uuid
  inquiry     Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fromStage   InquiryStage? @map("from_stage")
  toStage     InquiryStage  @map("to_stage")
  /// What caused it: a person ("manual") or an event ("quotation_sent"…).
  cause       String        @default("manual") @db.VarChar(40)
  lostReason  LostReason?   @map("lost_reason")
  note        String?
  changedById String?       @map("changed_by") @db.Uuid
  changedAt   DateTime      @default(now()) @map("changed_at") @db.Timestamptz

  @@index([inquiryId])
  @@map("inquiry_stage_changes")
}

model InquiryAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  inquiryId    String   @map("inquiry_id") @db.Uuid
  inquiry      Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  assigneeId   String?  @map("assignee_id") @db.Uuid
  assignedById String   @map("assigned_by") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  @@index([inquiryId])
  @@map("inquiry_assignments")
}

model InquiryNote {
  id        String   @id @default(uuid()) @db.Uuid
  inquiryId String   @map("inquiry_id") @db.Uuid
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  body      String
  authorId  String   @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([inquiryId])
  @@map("inquiry_notes")
}

/// Files on a deal. Optionally tied to an order step (inspection report, payment slip, B/L copy).
model Attachment {
  id           String    @id @default(uuid()) @db.Uuid
  inquiryId    String    @map("inquiry_id") @db.Uuid
  inquiry      Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fileName     String    @map("file_name") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(150)
  size         Int
  storageKey   String    @map("storage_key")
  /// urs | drawing | photo | specification | other
  kind         String    @default("other") @db.VarChar(20)
  note         String?   @db.VarChar(300)
  uploadedById String    @map("uploaded_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([inquiryId])
  @@map("attachments")
}

// ============================================================================
// Sourcing: factory prices for a deal (internal, never shown to customers)
// ============================================================================

model FactoryQuote {
  id           String    @id @default(uuid()) @db.Uuid
  inquiryId    String    @map("inquiry_id") @db.Uuid
  inquiry      Inquiry   @relation(fields: [inquiryId], references: [id])
  factoryId    String    @map("factory_id") @db.Uuid
  factory      Factory   @relation(fields: [factoryId], references: [id])
  /// The factory's own quotation number.
  reference    String?   @db.VarChar(80)
  receivedOn   DateTime  @map("received_on") @db.Date
  validUntil   DateTime? @map("valid_until") @db.Date
  currency     String    @default("CNY") @db.Char(3)
  /// EXW, FOB Qingdao, delivered to port…
  priceBasis   String?   @map("price_basis") @db.VarChar(60)
  leadTime     String?   @map("lead_time") @db.VarChar(120)
  moq          String?   @db.VarChar(60)
  paymentTerms String?   @map("payment_terms")
  notes        String?
  createdById  String    @map("created_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  lines FactoryQuoteLine[]

  @@index([inquiryId])
  @@index([factoryId])
  @@map("factory_quotes")
}

model FactoryQuoteLine {
  id              String         @id @default(uuid()) @db.Uuid
  factoryQuoteId  String         @map("factory_quote_id") @db.Uuid
  factoryQuote    FactoryQuote   @relation(fields: [factoryQuoteId], references: [id], onDelete: Cascade)
  /// The customer's item this answers (empty for extras the factory added).
  requestedItemId String?        @map("requested_item_id") @db.Uuid
  requestedItem   RequestedItem? @relation("AnswersItem", fields: [requestedItemId], references: [id], onDelete: SetNull)
  description     String
  model           String?        @db.VarChar(120)
  quantity        Decimal        @db.Decimal(12, 2)
  unit            String         @default("pcs") @db.VarChar(20)
  /// The factory's price for one unit, without tax.
  unitPrice       Decimal        @map("unit_price") @db.Decimal(14, 2)
  /// Tax % added on top of this item's price (13 unless changed): price + tax is what one unit costs Kebo.
  taxRate         Decimal        @default(13) @map("tax_rate") @db.Decimal(5, 2)
  sortOrder       Int            @default(0) @map("sort_order")

  preferredBy RequestedItem[] @relation("PreferredLine")
  quoteLines  QuoteLine[]

  @@index([factoryQuoteId])
  @@map("factory_quote_lines")
}

// ============================================================================
// Quotation: one per deal, with revisions R1, R2…
// ============================================================================

model Quotation {
  id        String   @id @default(uuid()) @db.Uuid
  /// QUO-2026-0007 (revisions print as QUO-2026-0007 R2)
  refNo     String   @unique @map("ref_no") @db.VarChar(30)
  inquiryId String   @unique @map("inquiry_id") @db.Uuid
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  revisions QuotationRevision[]

  @@map("quotations")
}

model QuotationRevision {
  id               String         @id @default(uuid()) @db.Uuid
  quotationId      String         @map("quotation_id") @db.Uuid
  quotation        Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  number           Int
  status           RevisionStatus @default(draft)
  currency         String         @default("USD") @db.Char(3)
  incoterm         Incoterm       @default(FOB)
  incotermPlace    String?        @map("incoterm_place") @db.VarChar(80)
  depositPercent   Decimal        @default(30) @map("deposit_percent") @db.Decimal(5, 2)
  balanceTerms     BalanceTerms   @default(before_shipment) @map("balance_terms")
  leadTime         String?        @map("lead_time") @db.VarChar(120)
  validUntil       DateTime       @map("valid_until") @db.Date
  subtotal         Decimal        @default(0) @db.Decimal(14, 2)
  discount         Decimal        @default(0) @db.Decimal(14, 2)
  total            Decimal        @default(0) @db.Decimal(14, 2)
  terms            String?
  notes            String?
  sentOn           DateTime?      @map("sent_on") @db.Date
  answeredOn       DateTime?      @map("answered_on") @db.Date
  /// Frozen when sent, so the PDF never changes afterwards.
  customerSnapshot Json?          @map("customer_snapshot")
  companySnapshot  Json?          @map("company_snapshot")
  createdById      String         @map("created_by") @db.Uuid
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  lines QuoteLine[]
  order Order?

  @@unique([quotationId, number])
  @@index([status])
  @@map("quotation_revisions")
}

model QuoteLine {
  id                 String            @id @default(uuid()) @db.Uuid
  revisionId         String            @map("revision_id") @db.Uuid
  revision           QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  requestedItemId    String?           @map("requested_item_id") @db.Uuid
  requestedItem      RequestedItem?    @relation(fields: [requestedItemId], references: [id], onDelete: SetNull)
  type               LineType          @default(goods)
  description        String
  model              String?           @db.VarChar(120)
  quantity           Decimal           @db.Decimal(12, 2)
  unit               String            @default("pcs") @db.VarChar(20)
  unitPrice          Decimal           @map("unit_price") @db.Decimal(14, 2)
  lineTotal          Decimal           @map("line_total") @db.Decimal(14, 2)
  /// Internal costing (never printed): what one unit costs us in the quotation currency, and where from.
  unitCost           Decimal?          @map("unit_cost") @db.Decimal(14, 2)
  factoryQuoteLineId String?           @map("factory_quote_line_id") @db.Uuid
  factoryQuoteLine   FactoryQuoteLine? @relation(fields: [factoryQuoteLineId], references: [id], onDelete: SetNull)
  /// Factory currency units per quotation currency unit when the cost was converted.
  fxRate             Decimal?          @map("fx_rate") @db.Decimal(14, 6)
  sortOrder          Int               @default(0) @map("sort_order")

  orderLines OrderLine[]

  @@index([revisionId])
  @@map("quote_lines")
}

// ============================================================================
// Orders: made when a revision is accepted; the checklist lives here
// ============================================================================

model Order {
  id              String            @id @default(uuid()) @db.Uuid
  /// SO-2026-0001
  refNo           String            @unique @map("ref_no") @db.VarChar(30)
  inquiryId       String            @map("inquiry_id") @db.Uuid
  inquiry         Inquiry           @relation(fields: [inquiryId], references: [id])
  revisionId      String            @unique @map("revision_id") @db.Uuid
  revision        QuotationRevision @relation(fields: [revisionId], references: [id])
  customerId      String            @map("customer_id") @db.Uuid
  customer        Customer          @relation(fields: [customerId], references: [id])
  status          OrderStatus       @default(open)
  stage           OrderStage        @default(confirmed)
  /// When the order entered its current stage.
  stageSince      DateTime          @default(now()) @map("stage_since") @db.Timestamptz
  orderedOn       DateTime          @map("ordered_on") @db.Date
  /// Ship date promised to the customer.
  shipBy          DateTime?         @map("ship_by") @db.Date
  /// Ready date the factory confirmed.
  readyOn         DateTime?         @map("ready_on") @db.Date
  shippedOn       DateTime?         @map("shipped_on") @db.Date
  blNo            String?           @map("bl_no") @db.VarChar(60)
  /// Heading over the lines on the documents, e.g. "COMPLETE AUTOMATIC LIQUID SYRUP FILLING LINE".
  documentTitle   String?           @map("document_title") @db.VarChar(200)
  /// Where the goods are unloaded, e.g. "Hairatan, Afghanistan" (the port of loading is the Incoterm place).
  portOfDischarge String?           @map("port_of_discharge") @db.VarChar(120)
  /// When the packing list was filled in (null: not yet).
  packedAt        DateTime?         @map("packed_at") @db.Timestamptz
  containerNo     String?           @map("container_no") @db.VarChar(120)
  shippingMarks   String?           @map("shipping_marks")
  currency        String            @db.Char(3)
  total           Decimal           @db.Decimal(14, 2)
  depositPercent  Decimal           @map("deposit_percent") @db.Decimal(5, 2)
  balanceTerms    BalanceTerms      @map("balance_terms")
  incoterm        Incoterm
  incotermPlace   String?           @map("incoterm_place") @db.VarChar(80)
  closedAt        DateTime?         @map("closed_at") @db.Timestamptz
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz
  cancelReason    String?           @map("cancel_reason")
  createdById     String            @map("created_by") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  lines        OrderLine[]
  stageChanges OrderStageChange[]
  payments     Payment[]
  planItems    PaymentPlanItem[]
  factoryPaid  FactoryPayment[]
  expenses     Expense[]

  @@index([inquiryId])
  @@index([status])
  @@index([stage])
  @@index([customerId])
  @@map("orders")
}

/// The accepted lines, frozen; shipped and invoiced quantities are tracked against them.
model OrderLine {
  id          String     @id @default(uuid()) @db.Uuid
  orderId     String     @map("order_id") @db.Uuid
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quoteLineId String?    @map("quote_line_id") @db.Uuid
  quoteLine   QuoteLine? @relation(fields: [quoteLineId], references: [id], onDelete: SetNull)
  type        LineType   @default(goods)
  description String
  model       String?    @db.VarChar(120)
  quantity    Decimal    @db.Decimal(12, 2)
  unit        String     @default("pcs") @db.VarChar(20)
  unitPrice   Decimal    @map("unit_price") @db.Decimal(14, 2)
  lineTotal   Decimal    @map("line_total") @db.Decimal(14, 2)
  unitCost    Decimal?   @map("unit_cost") @db.Decimal(14, 2)
  sortOrder   Int        @default(0) @map("sort_order")

  /// How many have come in from the factory so far (goods lines), and when last.
  receivedQty   Decimal   @default(0) @map("received_qty") @db.Decimal(12, 2)
  receivedOn    DateTime? @map("received_on") @db.Date
  /// The packing list, filled in before shipping (goods lines).
  packages      Int?
  packageType   String?   @map("package_type") @db.VarChar(40)
  netWeightKg   Decimal?  @map("net_weight_kg") @db.Decimal(12, 2)
  grossWeightKg Decimal?  @map("gross_weight_kg") @db.Decimal(12, 2)
  cbm           Decimal?  @db.Decimal(10, 3)

  @@index([orderId])
  @@map("order_lines")
}

/// One step of the order checklist (see @kebo/shared workflows/order).
/// Every move of an order between stages, with who and why.
model OrderStageChange {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStage OrderStage? @map("from_stage")
  toStage   OrderStage  @map("to_stage")
  note      String?
  /// Moved although there was a warning (no deposit, money still due).
  confirmed Boolean     @default(false)
  byId      String?     @map("by") @db.Uuid
  by        User?       @relation(fields: [byId], references: [id])
  at        DateTime    @default(now()) @db.Timestamptz

  @@index([orderId, at])
  @@map("order_stage_changes")
}

// ============================================================================
// Money: payments in (customer) and out (factory), invoices
// ============================================================================

/// The customer's instalments for an order (deposit, balance, or more). They add
/// up to the order total; money received pays the earliest first.
model PaymentPlanItem {
  id        String    @id @default(uuid()) @db.Uuid
  orderId   String    @map("order_id") @db.Uuid
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label     String    @db.VarChar(80)
  amount    Decimal   @db.Decimal(14, 2)
  /// Null until known (a balance before shipment is dated when the ship date is).
  dueOn     DateTime? @map("due_on") @db.Date
  sortOrder Int       @default(0) @map("sort_order")

  @@index([orderId])
  @@index([dueOn])
  @@map("payment_plan_items")
}

/// Money we sent a factory for an order, in the currency we paid in.
model FactoryPayment {
  id           String        @id @default(uuid()) @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  order        Order         @relation(fields: [orderId], references: [id])
  factoryId    String        @map("factory_id") @db.Uuid
  factory      Factory       @relation(fields: [factoryId], references: [id])
  kind         PaymentKind   @default(deposit)
  amount       Decimal       @db.Decimal(14, 2)
  currency     String        @db.Char(3)
  /// Units of `currency` per one unit of the order's currency when it was paid (CNY 7.10 per USD).
  rate         Decimal       @db.Decimal(14, 6)
  paidOn       DateTime      @map("paid_on") @db.Date
  method       PaymentMethod @default(bank_transfer)
  /// Who in our team paid it.
  paidById     String?       @map("paid_by") @db.Uuid
  paidBy       User?         @relation("FactoryPaymentPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  reference    String?       @db.VarChar(120)
  note         String?
  recordedById String        @map("recorded_by") @db.Uuid
  voidedAt     DateTime?     @map("voided_at") @db.Timestamptz
  voidReason   String?       @map("void_reason")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([orderId])
  @@index([factoryId])
  @@index([paidOn])
  @@map("factory_payments")
}

/// A cost: for one order (freight, inspection…) or for the company when orderId
/// is empty (rent, salaries…). Only managers and the super admin see these.
model Expense {
  id           String    @id @default(uuid()) @db.Uuid
  orderId      String?   @map("order_id") @db.Uuid
  order        Order?    @relation(fields: [orderId], references: [id])
  /// See EXPENSE_CATEGORIES in @kebo/shared.
  category     String    @db.VarChar(30)
  description  String    @db.VarChar(200)
  amount       Decimal   @db.Decimal(14, 2)
  currency     String    @db.Char(3)
  /// Units of `currency` per one unit of the main currency when it was spent.
  rate         Decimal   @db.Decimal(14, 6)
  spentOn      DateTime  @map("spent_on") @db.Date
  paidById     String?   @map("paid_by") @db.Uuid
  paidBy       User?     @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  reference    String?   @db.VarChar(120)
  note         String?
  recordedById String    @map("recorded_by") @db.Uuid
  voidedAt     DateTime? @map("voided_at") @db.Timestamptz
  voidReason   String?   @map("void_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([orderId])
  @@index([spentOn])
  @@map("expenses")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  kind         PaymentKind
  orderId      String        @map("order_id") @db.Uuid
  order        Order         @relation(fields: [orderId], references: [id])
  /// Incoming: the customer who paid.
  customerId   String?       @map("customer_id") @db.Uuid
  customer     Customer?     @relation(fields: [customerId], references: [id])
  /// What arrived from the customer.
  amount       Decimal       @db.Decimal(14, 2)
  /// Taken by banks on the way; still counts towards settling the amount due.
  bankCharges  Decimal       @default(0) @map("bank_charges") @db.Decimal(14, 2)
  currency     String        @db.Char(3)
  paidOn       DateTime      @map("paid_on") @db.Date
  method       PaymentMethod @default(bank_transfer)
  reference    String?       @db.VarChar(120)
  note         String?
  recordedById String        @map("recorded_by") @db.Uuid
  voidedAt     DateTime?     @map("voided_at") @db.Timestamptz
  voidReason   String?       @map("void_reason")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([orderId])
  @@index([paidOn])
  @@map("payments")
}

