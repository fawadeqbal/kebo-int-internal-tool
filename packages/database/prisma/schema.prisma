/// Files on a deal. Optionally tied to an order step (inspection report, payment slip, B/L copy).
model Attachment {
  id             String        @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId      String        @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company        Company       @relation(fields: [companyId], references: [id])
  inquiryId      String        @map("inquiry_id") @db.Uuid
  inquiry        Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// The factory offer this file is evidence for (its quotation, catalogue, WeChat screenshots). Internal: only people who see factory prices.
  factoryQuoteId String?       @map("factory_quote_id") @db.Uuid
  factoryQuote   FactoryQuote? @relation(fields: [factoryQuoteId], references: [id], onDelete: SetNull)
  fileName       String        @map("file_name") @db.VarChar(255)
  mimeType       String        @map("mime_type") @db.VarChar(150)
  size           Int
  storageKey     String        @map("storage_key")
  /// urs | drawing | photo | specification | factory_quote | other
  kind           String        @default("other") @db.VarChar(20)
  note           String?       @db.VarChar(300)
  uploadedById   String        @map("uploaded_by") @db.Uuid
  uploadedBy     User          @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  /// Added on an order (Documents v3: uploaded or dropped on a step): the order and the step it belongs to.
  orderId        String?       @map("order_id") @db.Uuid
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// payment | factory | production | shipping | documents | delivery
  step           String?       @db.VarChar(20)
  /// "Replace with a newer one": the newer file. The old one is kept (as an earlier version), out of the lists.
  replacedById   String?       @map("replaced_by") @db.Uuid
  replacedBy     Attachment?   @relation("AttachmentVersions", fields: [replacedById], references: [id], onDelete: SetNull)
  earlier        Attachment[]  @relation("AttachmentVersions")
  /// 1 for the first file; each replacement counts up.
  version        Int           @default(1)

  orderDocuments OrderDocument[]
  checklistItems OrderChecklistItem[]

  @@index([inquiryId])
  @@index([orderId])
  @@index([replacedById])
  @@index([factoryQuoteId])
  @@index([companyId])
  @@map("attachments")
}

// ============================================================================
// Sourcing: factory prices for a deal (internal, never shown to customers)
// ============================================================================

model FactoryQuote {
  id             String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId      String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company        Company   @relation(fields: [companyId], references: [id])
  inquiryId      String    @map("inquiry_id") @db.Uuid
  inquiry        Inquiry   @relation(fields: [inquiryId], references: [id])
  factoryId      String    @map("factory_id") @db.Uuid
  factory        Factory   @relation(fields: [factoryId], references: [id])
  /// The factory's own quotation number.
  reference      String?   @db.VarChar(80)
  receivedOn     DateTime  @map("received_on") @db.Date
  validUntil     DateTime? @map("valid_until") @db.Date
  currency       String    @default("CNY") @db.Char(3)
  /// The factory's prices have the tax in them (true: the price is our cost, the tax inside is only
  /// shown) or not (false: each line's tax % is added on top).
  taxIncluded    Boolean   @default(false) @map("tax_included")
  /// The offer's tax %, given to its lines (a line can still have its own).
  taxRate        Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 2)
  /// The factory's price basis (EXW, FOB, CFR…): what its prices already pay for.
  basis          Incoterm?
  /// Where the basis applies: "Zhangjiagang" (EXW), "Qingdao" (FOB)…
  basisPlace     String?   @map("basis_place") @db.VarChar(60)
  leadTime       String?   @map("lead_time") @db.VarChar(120)
  moq            String?   @db.VarChar(60)
  paymentTerms   String?   @map("payment_terms")
  /// The advance the factory asks when we order, in % (empty: the company's default in Settings). Seeds the
  /// factory's payment plan on the order and is printed on the purchase order; paymentTerms stays as a note.
  advancePercent Decimal?  @map("advance_percent") @db.Decimal(5, 2)
  notes          String?
  createdById    String    @map("created_by") @db.Uuid
  createdBy      User      @relation("FactoryQuoteCreator", fields: [createdById], references: [id])
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  lines   FactoryQuoteLine[]
  options QuotationOption[]
  files   Attachment[]

  requests FactoryRequest[]

  @@index([inquiryId])
  @@index([factoryId])
  @@index([companyId])
  @@map("factory_quotes")
}

model FactoryQuoteLine {
  id              String             @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId       String             @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company         Company            @relation(fields: [companyId], references: [id])
  factoryQuoteId  String             @map("factory_quote_id") @db.Uuid
  factoryQuote    FactoryQuote       @relation(fields: [factoryQuoteId], references: [id], onDelete: Cascade)
  /// The customer's item this answers (empty for extras the factory added).
  requestedItemId String?            @map("requested_item_id") @db.Uuid
  requestedItem   RequestedItem?     @relation("AnswersItem", fields: [requestedItemId], references: [id], onDelete: SetNull)
  description     String
  model           String?            @db.VarChar(120)
  quantity        Decimal            @db.Decimal(12, 2)
  unit            String             @default("pcs") @db.VarChar(20)
  /// The factory's price for one unit: without tax, or with tax included, as its offer says.
  unitPrice       Decimal            @map("unit_price") @db.Decimal(14, 2)
  /// This item's tax % (the offer's unless changed): added on top of the price, or already in it when the offer's prices include tax.
  taxRate         Decimal            @default(0) @map("tax_rate") @db.Decimal(5, 2)
  sortOrder       Int                @default(0) @map("sort_order")
  /// A part of another line of the same offer (the factory's own breakdown: machine, conveyor, spares…).
  parentId        String?            @map("parent_id") @db.Uuid
  parent          FactoryQuoteLine?  @relation("FactoryLineParts", fields: [parentId], references: [id], onDelete: Cascade)
  parts           FactoryQuoteLine[] @relation("FactoryLineParts")
  /// The same product across factories' offers: a line copied from another offer keeps that line's key, so offers can be compared product by product.
  productKey      String?            @map("product_key") @db.Uuid

  quoteLines QuoteLine[]

  @@index([factoryQuoteId])
  @@index([parentId])
  @@index([productKey])
  @@index([companyId])
  @@map("factory_quote_lines")
}

// ============================================================================
// Quotation: one per deal, with revisions R1, R2…
// ============================================================================

model Quotation {
  id        String   @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String   @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  /// QUO-2026-0007 (revisions print as QUO-2026-0007 R2)
  refNo     String   @map("ref_no") @db.VarChar(30)
  inquiryId String   @unique @map("inquiry_id") @db.Uuid
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  revisions QuotationRevision[]

  @@unique([companyId, refNo])
  @@map("quotations")
}

/// A revision keeps no figures of its own: its total, discount and lead time are its options' (the accepted
/// one, else Option A: see @kebo/shared revisionOption / revisionWorth).
model QuotationRevision {
  id               String         @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId        String         @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company          Company        @relation(fields: [companyId], references: [id])
  quotationId      String         @map("quotation_id") @db.Uuid
  quotation        Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  number           Int
  status           RevisionStatus @default(draft)
  currency         String         @default("USD") @db.Char(3)
  incoterm         Incoterm       @default(FOB)
  incotermPlace    String?        @map("incoterm_place") @db.VarChar(80)
  depositPercent   Decimal        @default(30) @map("deposit_percent") @db.Decimal(5, 2)
  balanceTerms     BalanceTerms   @default(before_shipment) @map("balance_terms")
  validUntil       DateTime       @map("valid_until") @db.Date
  /// Payment terms printed on the quotation (beyond the deposit and balance above), e.g. "By T/T; L/C at sight accepted".
  paymentTerms     String?        @map("payment_terms")
  /// Delivery terms printed on the quotation, e.g. "Packing: export wooden cases. Inspection before shipment."
  deliveryTerms    String?        @map("delivery_terms")
  notes            String?
  sentOn           DateTime?      @map("sent_on") @db.Date
  answeredOn       DateTime?      @map("answered_on") @db.Date
  /// Frozen when sent, so the PDF never changes afterwards.
  customerSnapshot Json?          @map("customer_snapshot")
  companySnapshot  Json?          @map("company_snapshot")
  createdById      String         @map("created_by") @db.Uuid
  createdBy        User           @relation("RevisionCreator", fields: [createdById], references: [id])
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  options QuotationOption[]
  lines   QuoteLine[]
  order   Order?

  @@unique([quotationId, number])
  @@index([status])
  @@index([companyId])
  @@map("quotation_revisions")
}

/// An option the customer can choose: one factory's offer (its lines, our prices),
/// or, without factory prices, the customer's own items priced by hand.
model QuotationOption {
  id                String            @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId         String            @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company           Company           @relation(fields: [companyId], references: [id])
  revisionId        String            @map("revision_id") @db.Uuid
  revision          QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  /// A, B, C…
  letter            String            @db.VarChar(2)
  sortOrder         Int               @default(0) @map("sort_order")
  factoryQuoteId    String?           @map("factory_quote_id") @db.Uuid
  factoryQuote      FactoryQuote?     @relation(fields: [factoryQuoteId], references: [id])
  status            OptionStatus      @default(open)
  leadTime          String?           @map("lead_time") @db.VarChar(120)
  subtotal          Decimal           @default(0) @db.Decimal(14, 2)
  discount          Decimal           @default(0) @db.Decimal(14, 2)
  total             Decimal           @default(0) @db.Decimal(14, 2)
  /// The factory's price basis when the option was saved (the offer can change later).
  factoryBasis      Incoterm?         @map("factory_basis")
  factoryBasisPlace String?           @map("factory_basis_place") @db.VarChar(60)

  lines QuoteLine[]
  costs OptionCost[]

  @@unique([revisionId, letter])
  @@index([factoryQuoteId])
  @@index([companyId])
  @@map("quotation_options")
}

/// A cost between the factory's price basis and the one we sell on (EXW → FOB: to the port…), part of the option's cost.
model OptionCost {
  id        String          @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String          @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company         @relation(fields: [companyId], references: [id])
  optionId  String          @map("option_id") @db.Uuid
  option    QuotationOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  step      BasisStep
  /// As entered, in its own currency.
  amount    Decimal         @db.Decimal(14, 2)
  currency  String          @db.Char(3)
  /// In the quotation's currency, at the rate when saved.
  cost      Decimal         @db.Decimal(14, 2)
  fxRate    Decimal?        @map("fx_rate") @db.Decimal(18, 8)
  note      String?         @db.VarChar(200)

  @@unique([optionId, step])
  @@index([companyId])
  @@map("option_costs")
}

model QuoteLine {
  id                 String            @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId          String            @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company            Company           @relation(fields: [companyId], references: [id])
  revisionId         String            @map("revision_id") @db.Uuid
  revision           QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  optionId           String            @map("option_id") @db.Uuid
  option             QuotationOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  requestedItemId    String?           @map("requested_item_id") @db.Uuid
  requestedItem      RequestedItem?    @relation(fields: [requestedItemId], references: [id], onDelete: SetNull)
  type               LineType          @default(goods)
  description        String
  model              String?           @db.VarChar(120)
  quantity           Decimal           @db.Decimal(12, 2)
  unit               String            @default("pcs") @db.VarChar(20)
  unitPrice          Decimal           @map("unit_price") @db.Decimal(14, 2)
  lineTotal          Decimal           @map("line_total") @db.Decimal(14, 2)
  /// Internal costing (never printed): what one unit costs us in the quotation currency, and where from.
  unitCost           Decimal?          @map("unit_cost") @db.Decimal(14, 2)
  factoryQuoteLineId String?           @map("factory_quote_line_id") @db.Uuid
  factoryQuoteLine   FactoryQuoteLine? @relation(fields: [factoryQuoteLineId], references: [id], onDelete: SetNull)
  /// Factory currency units per quotation currency unit when the cost was converted.
  fxRate             Decimal?          @map("fx_rate") @db.Decimal(24, 14)
  sortOrder          Int               @default(0) @map("sort_order")

  orderLines OrderLine[]

  @@index([revisionId])
  @@index([optionId])
  @@index([companyId])
  @@map("quote_lines")
}

// ============================================================================
// Orders: made when a revision is accepted; the checklist lives here
// ============================================================================

model Order {
  id                  String            @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId           String            @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company             Company           @relation(fields: [companyId], references: [id])
  /// SO-2026-0001
  refNo               String            @map("ref_no") @db.VarChar(30)
  inquiryId           String            @map("inquiry_id") @db.Uuid
  inquiry             Inquiry           @relation(fields: [inquiryId], references: [id])
  revisionId          String            @unique @map("revision_id") @db.Uuid
  revision            QuotationRevision @relation(fields: [revisionId], references: [id])
  customerId          String            @map("customer_id") @db.Uuid
  customer            Customer          @relation(fields: [customerId], references: [id])
  status              OrderStatus       @default(open)
  stage               OrderStage        @default(confirmed)
  /// When the order entered its current stage.
  stageSince          DateTime          @default(now()) @map("stage_since") @db.Timestamptz
  orderedOn           DateTime          @map("ordered_on") @db.Date
  /// The proforma invoice's number once issued, e.g. KEB260916TN07 (prefix, issue date, customer letters, the handler's count this year).
  /// An index only: the proforma itself is its OrderPaper rows (kind "proforma"), final with a snapshot; only issuing writes these.
  proformaNo          String?           @map("proforma_no") @db.VarChar(40)
  proformaIssuedOn    DateTime?         @map("proforma_issued_on") @db.Date
  /// The buyer as on the order (@kebo/shared BuyerSnapshot): taken when the order is made, printed on every paper of the
  /// order; "Refresh from customer" (with a reason) takes it again. Final papers keep the buyer they were printed with.
  buyerSnapshot       Json?             @map("buyer_snapshot")
  /// The quotation's own payment text is printed on the papers even though the route now differs from what it said.
  printQuotedTerms    Boolean           @default(false) @map("print_quoted_terms")
  /// The last receipt and payment-request numbers given (RC-…-n, PR-…-n): numbers are given once and never reused.
  lastReceiptNo       Int               @default(0) @map("last_receipt_no")
  lastRequestNo       Int               @default(0) @map("last_request_no")
  /// Ship date promised to the customer (ours: with an LC its latest shipment date is shown beside it, and a
  /// ship-by later than that is warned about).
  shipBy              DateTime?         @map("ship_by") @db.Date
  // The ready date is each factory's (OrderFactory.readyOn); the order's is the latest of them (worked out).
  /// Heading over the lines on the documents, e.g. "COMPLETE AUTOMATIC LIQUID SYRUP FILLING LINE".
  documentTitle       String?           @map("document_title") @db.VarChar(200)
  /// The contract destination, e.g. "Hairatan, Afghanistan": printed on the proforma and the contract, and the
  /// default port of discharge of a new shipment. Shipped on, the B/L and the container are the shipments'
  /// (Shipment 1 for the papers; shipped on = the earliest day one left), never the order's.
  portOfDischarge     String?           @map("port_of_discharge") @db.VarChar(120)
  /// When the packing list was filled in (null: not yet).
  packedAt            DateTime?         @map("packed_at") @db.Timestamptz
  shippingMarks       String?           @map("shipping_marks")
  currency            String            @db.Char(3)
  total               Decimal           @db.Decimal(14, 2)
  depositPercent      Decimal           @map("deposit_percent") @db.Decimal(5, 2)
  balanceTerms        BalanceTerms      @map("balance_terms")
  incoterm            Incoterm
  incotermPlace       String?           @map("incoterm_place") @db.VarChar(80)
  /// The main currency when the order was made, and how many of the order's currency one unit of it bought
  /// (USD order, USD main: 1; CNY order: 7.1). Revenue and costs are turned into the main currency at this rate,
  /// so changing the rates in Settings never moves past months. Empty: not known (Settings is used).
  mainCurrency        String?           @map("main_currency") @db.Char(3)
  mainRate            Decimal?          @map("main_rate") @db.Decimal(24, 14)
  /// How the customer pays (informal, bank contract, LC); empty until chosen.
  paymentRoute        PaymentRoute?     @map("payment_route")
  /// Informal route: the balance before shipment or against the B/L copy (before_shipment | against_bl_copy).
  balanceWhen         String?           @map("balance_when") @db.VarChar(20)
  /// LC route: at_sight | deferred, and the deferred days counted from "papers reached their bank".
  lcTerms             String?           @map("lc_terms") @db.VarChar(10)
  lcDays              Int?              @map("lc_days")
  /// When we placed the order with the factory.
  factoryOrderedOn    DateTime?         @map("factory_ordered_on") @db.Date
  /// The factory's own number for our order ("their order no.").
  factoryOrderNo      String?           @map("factory_order_no") @db.VarChar(60)
  /// Delivery at the customer's. The condition the goods arrived in is the goods lines' (worked out: the worst
  /// of them, @kebo/shared deliveryConditionOf); the order keeps only a note.
  deliveredOn         DateTime?         @map("delivered_on") @db.Date
  deliveryNote        String?           @map("delivery_note")
  /// Who received the goods at the customer's.
  deliveryReceivedBy  String?           @map("delivery_received_by") @db.VarChar(120)
  /// The site acceptance test: our engineer, when, and who signed for the customer.
  satEngineerId       String?           @map("sat_engineer") @db.Uuid
  satEngineer         User?             @relation("OrderSatEngineer", fields: [satEngineerId], references: [id], onDelete: SetNull)
  satPlannedOn        DateTime?         @map("sat_planned_on") @db.Date
  satDoneOn           DateTime?         @map("sat_done_on") @db.Date
  satSignedBy         String?           @map("sat_signed_by") @db.VarChar(120)
  closedAt            DateTime?         @map("closed_at") @db.Timestamptz
  /// When the company's checklist was copied into the order (null: not yet; it is copied on first read).
  checklistSeededAt   DateTime?         @map("checklist_seeded_at") @db.Timestamptz
  cancelledAt         DateTime?         @map("cancelled_at") @db.Timestamptz
  cancelReason        String?           @map("cancel_reason")
  /// Money received when it was cancelled: credit | refund | fee; money paid to the factory: refund_due | loss.
  cancelCustomerMoney String?           @map("cancel_customer_money") @db.VarChar(10)
  cancelFactoryMoney  String?           @map("cancel_factory_money") @db.VarChar(12)
  createdById         String            @map("created_by") @db.Uuid
  createdBy           User              @relation("OrderCreator", fields: [createdById], references: [id])
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  lines        OrderLine[]
  stageChanges OrderStageChange[]
  payments     Payment[]
  planItems    PaymentPlanItem[]
  factoryPaid  FactoryPayment[]
  expenses     Expense[]
  costs        OrderCost[]
  bankContract OrderBankContract?
  shipments    Shipment[]
  documents    OrderDocument[]
  bankSteps    OrderBankStep[]
  satChecks    SatCheck[]
  claims       OrderClaim[]
  checklist    OrderChecklistItem[]
  files        Attachment[]
  factoryPlan  FactoryPaymentPlan[]
  submissions  MoneySubmission[]
  /// Each factory's ready date (the order's ready date is the latest of them).
  factories    OrderFactory[]
  credits      CustomerCredit[]
  papers       OrderPaper[]
  fact         OrderFact?
  factoryFacts FactoryOrderFact[]
  recordNotes  RecordNote[]
  followUps    FollowUp[]

  @@unique([companyId, refNo])
  @@unique([companyId, proformaNo])
  @@index([inquiryId])
  @@index([status])
  @@index([stage])
  @@index([customerId])
  @@map("orders")
}

/// The accepted lines, frozen; shipped and invoiced quantities are tracked against them.
model OrderLine {
  id          String     @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId   String     @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company     Company    @relation(fields: [companyId], references: [id])
  orderId     String     @map("order_id") @db.Uuid
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quoteLineId String?    @map("quote_line_id") @db.Uuid
  quoteLine   QuoteLine? @relation(fields: [quoteLineId], references: [id], onDelete: SetNull)
  type        LineType   @default(goods)
  description String
  model       String?    @db.VarChar(120)
  /// The customs code printed on the commercial invoice and the contract (e.g. 8422.40).
  hsCode      String?    @map("hs_code") @db.VarChar(20)
  quantity    Decimal    @db.Decimal(12, 2)
  unit        String     @default("pcs") @db.VarChar(20)
  unitPrice   Decimal    @map("unit_price") @db.Decimal(14, 2)
  lineTotal   Decimal    @map("line_total") @db.Decimal(14, 2)
  unitCost    Decimal?   @map("unit_cost") @db.Decimal(14, 2)
  sortOrder   Int        @default(0) @map("sort_order")

  /// The factory's price this line was bought at, frozen when the order was made: what we owe the
  /// factory is worked out from these, so changing or removing the offer later never changes it.
  factoryId          String?  @map("factory_id") @db.Uuid
  factory            Factory? @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  factoryUnitPrice   Decimal? @map("factory_unit_price") @db.Decimal(14, 2)
  factoryTaxRate     Decimal? @map("factory_tax_rate") @db.Decimal(5, 2)
  /// The factory's price already had the tax in it (its offer said so): the tax is not added again.
  factoryTaxIncluded Boolean  @default(false) @map("factory_tax_included")
  factoryCurrency    String?  @map("factory_currency") @db.Char(3)

  /// How many have come in from the factory so far (goods lines), and when last.
  receivedQty        Decimal   @default(0) @map("received_qty") @db.Decimal(12, 2)
  receivedOn         DateTime? @map("received_on") @db.Date
  /// The packing list, filled in before shipping (goods lines).
  packages           Int?
  packageType        String?   @map("package_type") @db.VarChar(40)
  netWeightKg        Decimal?  @map("net_weight_kg") @db.Decimal(12, 2)
  grossWeightKg      Decimal?  @map("gross_weight_kg") @db.Decimal(12, 2)
  cbm                Decimal?  @db.Decimal(10, 3)
  /// What reached the customer (Delivery & SAT, goods lines): how many, in what condition
  /// (good | minor_damage | damaged | missing) and a short note.
  deliveredQty       Decimal   @default(0) @map("delivered_qty") @db.Decimal(12, 2)
  deliveredCondition String?   @map("delivered_condition")
  deliveryNote       String?   @map("delivery_note") @db.VarChar(200)

  @@index([orderId])
  @@index([factoryId])
  @@index([companyId])
  @@map("order_lines")
}

/// A cost between the factory's price basis and the one we sold on (EXW → CFR: to the port, sea freight…),
/// copied from the accepted option when the order was made: part of the order's cost.
model OrderCost {
  id        String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id])
  orderId   String    @map("order_id") @db.Uuid
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  step      BasisStep
  /// As entered on the quotation, in its own currency.
  amount    Decimal   @db.Decimal(14, 2)
  currency  String    @db.Char(3)
  /// In the order's currency, at the rate when the quotation was saved.
  cost      Decimal   @db.Decimal(14, 2)
  fxRate    Decimal?  @map("fx_rate") @db.Decimal(18, 8)
  note      String?   @db.VarChar(200)

  @@unique([orderId, step])
  @@index([companyId])
  @@map("order_costs")
}

/// One step of the order checklist (see @kebo/shared workflows/order).
/// Every move of an order between stages, with who and why.
model OrderStageChange {
  id        String      @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String      @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company     @relation(fields: [companyId], references: [id])
  orderId   String      @map("order_id") @db.Uuid
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStage OrderStage? @map("from_stage")
  toStage   OrderStage  @map("to_stage")
  note      String?
  /// Moved although there was a warning (no deposit, money still due).
  confirmed Boolean     @default(false)
  byId      String?     @map("by") @db.Uuid
  by        User?       @relation(fields: [byId], references: [id])
  at        DateTime    @default(now()) @db.Timestamptz

  @@index([orderId, at])
  @@index([companyId])
  @@map("order_stage_changes")
}

// ============================================================================
// Order flow: asking factories, the bank route, production, shipping,
// the document set and its bank chain, delivery and SAT, claims
// ============================================================================

/// One factory asked for a price on an inquiry (the spec sent), and whether it answered.
model FactoryRequest {
  id             String               @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId      String               @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company        Company              @relation(fields: [companyId], references: [id])
  inquiryId      String               @map("inquiry_id") @db.Uuid
  inquiry        Inquiry              @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  factoryId      String               @map("factory_id") @db.Uuid
  factory        Factory              @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  status         FactoryRequestStatus @default(sent)
  sentOn         DateTime             @map("sent_on") @db.Date
  /// How the list was sent: wechat | email | whatsapp | phone | visit | other.
  channel        String?              @db.VarChar(20)
  /// When we asked them to answer by.
  replyBy        DateTime?            @map("reply_by") @db.Date
  /// The offer they sent back, once entered.
  factoryQuoteId String?              @map("factory_quote_id") @db.Uuid
  factoryQuote   FactoryQuote?        @relation(fields: [factoryQuoteId], references: [id], onDelete: SetNull)
  note           String?              @db.VarChar(500)
  createdById    String               @map("created_by") @db.Uuid
  createdBy      User                 @relation("FactoryRequestCreator", fields: [createdById], references: [id])
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([inquiryId, factoryId])
  @@index([factoryId])
  @@index([companyId])
  @@map("factory_requests")
}

/// The bank contract or letter of credit an order is paid on (one per order).
model OrderBankContract {
  id           String             @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId    String             @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company      Company            @relation(fields: [companyId], references: [id])
  orderId      String             @unique @map("order_id") @db.Uuid
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// The contract or LC number.
  number       String?            @db.VarChar(60)
  status       BankContractStatus @default(draft)
  /// The customer's bank (where the documents go) and ours (where they start).
  customerBank String?            @map("customer_bank") @db.VarChar(160)
  ourBank      String?            @map("our_bank") @db.VarChar(160)
  amount       Decimal?           @db.Decimal(14, 2)
  currency     String?            @db.Char(3)
  openedOn     DateTime?          @map("opened_on") @db.Date
  /// LC: the last day to ship, and when it expires.
  latestShipOn DateTime?          @map("latest_ship_on") @db.Date
  expiresOn    DateTime?          @map("expires_on") @db.Date
  note         String?
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId])
  @@map("order_bank_contracts")
}

/// One item of an order's checklist (see @kebo/shared workflows/checklist). Items with a `key` are the
/// automatic ones (ticked from the order's data): their row only keeps overrides (due date, person, skip,
/// note). Items without a key are the company's own (copied from its list, or added on the order).
model OrderChecklistItem {
  id           String        @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId    String        @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company      Company       @relation(fields: [companyId], references: [id])
  orderId      String        @map("order_id") @db.Uuid
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// payment | factory | production | shipping | documents | delivery
  step         String        @db.VarChar(20)
  /// The automatic item this row overrides ("deposit_in", "doc:bill_of_lading"); null for own items.
  key          String?       @db.VarChar(80)
  title        String?       @db.VarChar(200)
  /// done | fill | upload | pay | make | send
  tool         String        @default("done") @db.VarChar(10)
  /// The fill tool's fields: [{ key, label, type: text | date | number | file }].
  fields       Json          @default("[]")
  /// What the item collected, by field key.
  data         Json          @default("{}")
  /// Make and Send items: the paper the app makes (sales-contract, shipping-advice…).
  paper        String?       @db.VarChar(40)
  /// Only for orders paid this way.
  route        PaymentRoute?
  /// The factory a production item is about (from the old production timeline).
  factoryId    String?       @map("factory_id") @db.Uuid
  factory      Factory?      @relation(fields: [factoryId], references: [id], onDelete: SetNull)
  dueOn        DateTime?     @map("due_on") @db.Date
  assigneeId   String?       @map("assignee_id") @db.Uuid
  assignee     User?         @relation("ChecklistAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  doneAt       DateTime?     @map("done_at") @db.Timestamptz
  doneById     String?       @map("done_by") @db.Uuid
  doneBy       User?         @relation("ChecklistDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  skippedAt    DateTime?     @map("skipped_at") @db.Timestamptz
  skipReason   String?       @map("skip_reason") @db.VarChar(300)
  note         String?       @db.VarChar(1000)
  attachmentId String?       @map("attachment_id") @db.Uuid
  attachment   Attachment?   @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  sortOrder    Int           @default(0) @map("sort_order")
  createdById  String        @map("created_by") @db.Uuid
  createdBy    User          @relation("ChecklistCreator", fields: [createdById], references: [id])
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([orderId, key])
  @@index([orderId, step, sortOrder])
  @@index([companyId])
  @@map("order_checklist_items")
}

/// The company's own checklist (Settings › Order checklist): copied into each new order the first time
/// its checklist is opened. Later changes never touch orders that already have theirs.
model ChecklistTemplate {
  id        String        @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String        @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company       @relation(fields: [companyId], references: [id])
  step      String        @db.VarChar(20)
  title     String        @db.VarChar(200)
  tool      String        @default("done") @db.VarChar(10)
  fields    Json          @default("[]")
  /// Make and Send items: the paper the app makes.
  paper     String?       @db.VarChar(40)
  route     PaymentRoute?
  /// Due this many days after the order date (empty: no due date).
  dueDays   Int?          @map("due_days")
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([companyId, step, sortOrder])
  @@map("checklist_templates")
}

/// One shipment of an order (an order can go in more than one). The only place for its B/L, the day it left,
/// the container, seal, vessel, ports and ETD/ETA; Shipment 1 (the first made) is the one the papers print.
/// An order without the shipping module still has one, typed from the order's Details card.
model Shipment {
  id              String         @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId       String         @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company         Company        @relation(fields: [companyId], references: [id])
  orderId         String         @map("order_id") @db.Uuid
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mode            ShipMode       @default(sea)
  status          ShipmentStatus @default(planned)
  forwarder       String?        @db.VarChar(120)
  bookingNo       String?        @map("booking_no") @db.VarChar(60)
  /// The bill of lading (sea) or air waybill (air) number.
  blNo            String?        @map("bl_no") @db.VarChar(60)
  vessel          String?        @db.VarChar(120)
  portOfLoading   String?        @map("port_of_loading") @db.VarChar(120)
  portOfDischarge String?        @map("port_of_discharge") @db.VarChar(120)
  containerNo     String?        @map("container_no") @db.VarChar(120)
  /// 20GP, 40HQ, LCL…
  containerType   String?        @map("container_type") @db.VarChar(20)
  sealNo          String?        @map("seal_no") @db.VarChar(40)
  /// The day the container was loaded.
  loadedOn        DateTime?      @map("loaded_on") @db.Date
  /// The container's verified gross mass (VGM), kg.
  vgmKg           Decimal?       @map("vgm_kg") @db.Decimal(10, 2)
  etd             DateTime?      @db.Date
  eta             DateTime?      @db.Date
  departedOn      DateTime?      @map("departed_on") @db.Date
  arrivedOn       DateTime?      @map("arrived_on") @db.Date
  note            String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  documents OrderDocument[]

  @@index([orderId])
  @@index([companyId])
  @@map("shipments")
}

/// One paper of the order's document set: its number, whether it is ready, and the file (kept with the deal's files).
model OrderDocument {
  id           String              @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId    String              @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company      Company             @relation(fields: [companyId], references: [id])
  orderId      String              @map("order_id") @db.Uuid
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipmentId   String?             @map("shipment_id") @db.Uuid
  shipment     Shipment?           @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  kind         OrderDocumentKind
  /// For "other": what it is.
  title        String?             @db.VarChar(120)
  number       String?             @db.VarChar(60)
  issuedOn     DateTime?           @map("issued_on") @db.Date
  status       OrderDocumentStatus @default(missing)
  attachmentId String?             @map("attachment_id") @db.Uuid
  attachment   Attachment?         @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  note         String?             @db.VarChar(500)
  /// Kept elsewhere (status elsewhere): where it is — a shelf, a person, a bank, an email. No file in the app.
  keptWhere    String?             @map("kept_where") @db.VarChar(200)
  /// Made by the app: the final paper this row is.
  paperId      String?             @map("paper_id") @db.Uuid
  paper        OrderPaper?         @relation(fields: [paperId], references: [id], onDelete: SetNull)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  @@index([orderId])
  @@index([companyId])
  @@map("order_documents")
}

/// A paper the app makes from the order (sales contract, commercial invoice, …; see @kebo/shared workflows/papers),
/// and the order's own proforma ("proforma": final when issued) and packing list ("packing-list": final once shipped):
/// a draft until made final; final keeps the snapshot of exactly what was printed and locks the number.
/// "Make again" adds the next version as a draft and keeps the earlier ones.
model OrderPaper {
  id        String          @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String          @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company         @relation(fields: [companyId], references: [id])
  orderId   String          @map("order_id") @db.Uuid
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// The print slug: sales-contract, commercial-invoice, purchase-order…
  kind      String          @db.VarChar(40)
  /// Which one when an order has several of the kind (a purchase order: the factory's id); empty otherwise.
  ref       String          @default("") @db.VarChar(60)
  /// CI-2026-0031 (follows the order's number); the same in every version.
  number    String          @db.VarChar(40)
  version   Int             @default(1)
  /// draft | final
  status    String          @default("draft") @db.VarChar(10)
  /// { prices, showHs, lcStatement, stamp }
  options   Json            @default("{}")
  /// Final: everything the paper was printed from (the API's PaperDoc), so it never changes afterwards.
  snapshot  Json?
  madeById  String          @map("made_by") @db.Uuid
  madeBy    User            @relation("PaperMadeBy", fields: [madeById], references: [id])
  madeAt    DateTime        @default(now()) @map("made_at") @db.Timestamptz
  finalAt   DateTime?       @map("final_at") @db.Timestamptz
  documents OrderDocument[]

  @@unique([orderId, kind, ref, version])
  @@index([companyId])
  @@map("order_papers")
}

/// One step of the documents' trip through the banks, when it happened and its reference (DHL tracking, bank ref).
model OrderBankStep {
  id        String       @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String       @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company      @relation(fields: [companyId], references: [id])
  orderId   String       @map("order_id") @db.Uuid
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  step      BankStepKind
  doneOn    DateTime     @map("done_on") @db.Date
  /// DHL, FedEx… for the courier step.
  courier   String?      @db.VarChar(60)
  reference String?      @db.VarChar(120)
  note      String?      @db.VarChar(500)
  /// "Money reached us": the payment that recorded it.
  paymentId String?      @map("payment_id") @db.Uuid
  payment   Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([orderId, step])
  @@index([companyId])
  @@map("order_bank_steps")
}

/// One point of the site acceptance test our engineer runs at the customer's.
model SatCheck {
  id        String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id])
  orderId   String    @map("order_id") @db.Uuid
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item      String    @db.VarChar(200)
  result    SatResult @default(pending)
  note      String?   @db.VarChar(500)
  sortOrder Int       @default(0) @map("sort_order")

  @@index([orderId])
  @@index([companyId])
  @@map("sat_checks")
}

/// Something wrong after delivery (damage, missing parts, a fault) and how it was settled.
model OrderClaim {
  id         String      @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId  String      @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company    Company     @relation(fields: [companyId], references: [id])
  orderId    String      @map("order_id") @db.Uuid
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title      String      @db.VarChar(160)
  detail     String?
  status     ClaimStatus @default(open)
  openedOn   DateTime    @map("opened_on") @db.Date
  resolvedOn DateTime?   @map("resolved_on") @db.Date
  resolution String?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@index([orderId])
  @@index([companyId])
  @@map("order_claims")
}

// ============================================================================
// Money: payments in (customer) and out (factory), invoices
// ============================================================================

/// The customer's instalments for an order (deposit, balance, or more). They add
/// up to the order total; money received pays the earliest first.
model PaymentPlanItem {
  id        String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id])
  orderId   String    @map("order_id") @db.Uuid
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label     String    @db.VarChar(80)
  amount    Decimal   @db.Decimal(14, 2)
  /// The date of a `fixed` row (typed by hand, or the deposit's); rows with another rule have none stored:
  /// their date is worked out each time from the order's dates (@kebo/shared planItemDue).
  dueOn     DateTime? @map("due_on") @db.Date
  sortOrder Int       @default(0) @map("sort_order")
  /// Built from the route: deposit | balance (null: typed by hand).
  part      String?   @db.VarChar(10)
  /// When it falls due: fixed (dueOn) | on_ready (the order's ready date, the latest factory's) |
  /// on_ship_plus_days (`dueDays` after the goods left) | after_papers (`dueDays` after the papers reached
  /// the customer's bank, LC); null: no date yet.
  dueRule   String?   @map("due_rule") @db.VarChar(20)
  dueDays   Int?      @map("due_days")
  /// Its payment request's number (PR-2026-0031-n), given when the row is made and never changed or reused
  /// (a rebuilt plan keeps the numbers of the rows it keeps; new rows get the next one). Set by the database.
  requestNo Int?      @map("request_no")

  @@unique([orderId, requestNo])
  @@index([orderId])
  @@index([dueOn])
  @@index([companyId])
  @@map("payment_plan_items")
}

/// Money we sent a factory for an order, in the currency we paid in.
model FactoryPayment {
  id           String        @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId    String        @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company      Company       @relation(fields: [companyId], references: [id])
  orderId      String        @map("order_id") @db.Uuid
  order        Order         @relation(fields: [orderId], references: [id])
  factoryId    String        @map("factory_id") @db.Uuid
  factory      Factory       @relation(fields: [factoryId], references: [id])
  kind         PaymentKind   @default(deposit)
  amount       Decimal       @db.Decimal(14, 2)
  currency     String        @db.Char(3)
  /// Units of `currency` per one unit of the order's currency when it was paid (CNY 7.10 per USD).
  rate         Decimal       @db.Decimal(24, 14)
  paidOn       DateTime      @map("paid_on") @db.Date
  method       PaymentMethod @default(bank_transfer)
  /// Who in our team paid it.
  paidById     String?       @map("paid_by") @db.Uuid
  paidBy       User?         @relation("FactoryPaymentPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  reference    String?       @db.VarChar(120)
  note         String?
  /// Which of our accounts the money moved through (cash, a bank, a wallet).
  accountId    String?       @map("account_id") @db.Uuid
  account      MoneyAccount? @relation(fields: [accountId], references: [id])
  /// A photo or PDF proving the payment (bank slip, transfer screenshot).
  fileKey      String?       @map("file_key")
  fileName     String?       @map("file_name") @db.VarChar(255)
  fileType     String?       @map("file_type") @db.VarChar(150)
  fileSize     Int?          @map("file_size")
  recordedById String        @map("recorded_by") @db.Uuid
  recordedBy   User          @relation("FactoryPaymentRecorder", fields: [recordedById], references: [id])
  voidedAt     DateTime?     @map("voided_at") @db.Timestamptz
  voidReason   String?       @map("void_reason")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([orderId])
  @@index([factoryId])
  @@index([paidOn])
  @@index([accountId])
  @@index([companyId])
  @@map("factory_payments")
}

/// A cost: for one order (freight, inspection…) or for the company when orderId
/// is empty (rent, salaries…). Only managers and the super admin see these.
model Expense {
  id              String        @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId       String        @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company         Company       @relation(fields: [companyId], references: [id])
  orderId         String?       @map("order_id") @db.Uuid
  order           Order?        @relation(fields: [orderId], references: [id])
  /// Who it was spent on (a dinner, a ticket to visit them…); for a deal or an order always its customer. Empty: the company's own cost.
  customerId      String?       @map("customer_id") @db.Uuid
  customer        Customer?     @relation(fields: [customerId], references: [id])
  /// The deal it was spent on (a trip to check products, samples…), won or lost; for an order always its deal.
  inquiryId       String?       @map("inquiry_id") @db.Uuid
  inquiry         Inquiry?      @relation(fields: [inquiryId], references: [id])
  /// The factory visited or paid for (a trip to check its products, an inspection there).
  factoryId       String?       @map("factory_id") @db.Uuid
  factory         Factory?      @relation(fields: [factoryId], references: [id])
  /// See EXPENSE_CATEGORIES in @kebo/shared.
  category        String        @db.VarChar(30)
  description     String        @db.VarChar(200)
  amount          Decimal       @db.Decimal(14, 2)
  currency        String        @db.Char(3)
  /// Units of `currency` per one unit of the main currency when it was spent (14 decimals, so a
  /// PKR company's 1/280 for USD stays exact enough: USD 100,000 is PKR 28,000,000.00).
  rate            Decimal       @db.Decimal(24, 14)
  spentOn         DateTime      @map("spent_on") @db.Date
  paidById        String?       @map("paid_by") @db.Uuid
  paidBy          User?         @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  reference       String?       @db.VarChar(120)
  note            String?
  /// A photo or PDF of the receipt or ticket.
  receiptKey      String?       @map("receipt_key")
  receiptName     String?       @map("receipt_name") @db.VarChar(255)
  receiptType     String?       @map("receipt_type") @db.VarChar(150)
  receiptSize     Int?          @map("receipt_size")
  /// Which of our accounts the money moved through (cash, a bank, a wallet).
  accountId       String?       @map("account_id") @db.Uuid
  account         MoneyAccount? @relation(fields: [accountId], references: [id])
  /// On an order: the step it belongs to (FlowStep: payment, factory, production, shipping, documents, delivery).
  step            String?       @db.VarChar(20)
  /// Who bears it: us (cuts the order's profit), customer (added to what they owe), factory (taken off what we owe it).
  borneBy         String        @default("us") @map("borne_by") @db.VarChar(10)
  /// Paid by `paidBy` from their own money: we owe it back until `repaidOn`.
  ownMoney        Boolean       @default(false) @map("own_money")
  repaidOn        DateTime?     @map("repaid_on") @db.Date
  /// The account the money was paid back from.
  repaidAccountId String?       @map("repaid_account_id") @db.Uuid
  repaidAccount   MoneyAccount? @relation("ExpenseRepaidFrom", fields: [repaidAccountId], references: [id])
  recordedById    String        @map("recorded_by") @db.Uuid
  recordedBy      User          @relation("ExpenseRecorder", fields: [recordedById], references: [id])
  voidedAt        DateTime?     @map("voided_at") @db.Timestamptz
  voidReason      String?       @map("void_reason")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([orderId])
  @@index([customerId])
  @@index([inquiryId])
  @@index([factoryId])
  @@index([spentOn])
  @@index([accountId])
  @@index([repaidAccountId])
  @@index([companyId])
  @@map("expenses")
}

model Payment {
  id               String           @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId        String           @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company          Company          @relation(fields: [companyId], references: [id])
  kind             PaymentKind
  orderId          String           @map("order_id") @db.Uuid
  order            Order            @relation(fields: [orderId], references: [id])
  /// Incoming: the customer who paid.
  customerId       String?          @map("customer_id") @db.Uuid
  customer         Customer?        @relation(fields: [customerId], references: [id])
  /// What it counts as on the order, in the order's currency (received ÷ rate, to the cent).
  amount           Decimal          @db.Decimal(14, 2)
  /// Taken by banks on the way; still counts towards settling the amount due.
  bankCharges      Decimal          @default(0) @map("bank_charges") @db.Decimal(14, 2)
  currency         String           @db.Char(3)
  /// What really arrived (into the account, in its currency) and the rate agreed: units of the received
  /// currency per one unit of the order's currency. Kept, so later rate changes never move it.
  receivedAmount   Decimal          @map("received_amount") @db.Decimal(14, 2)
  receivedCurrency String           @map("received_currency") @db.Char(3)
  rate             Decimal          @default(1) @db.Decimal(24, 14)
  /// Someone paying for the customer (their agent, a relative).
  paidByName       String?          @map("paid_by_name") @db.VarChar(120)
  /// One transfer split over several orders (and the customer's credit).
  receiptId        String?          @map("receipt_id") @db.Uuid
  receipt          CustomerReceipt? @relation(fields: [receiptId], references: [id])
  paidOn           DateTime         @map("paid_on") @db.Date
  method           PaymentMethod    @default(bank_transfer)
  reference        String?          @db.VarChar(120)
  note             String?
  /// Which of our accounts the money moved through (cash, a bank, a wallet).
  accountId        String?          @map("account_id") @db.Uuid
  account          MoneyAccount?    @relation(fields: [accountId], references: [id])
  /// A photo or PDF proving the payment (bank slip, transfer screenshot).
  fileKey          String?          @map("file_key")
  fileName         String?          @map("file_name") @db.VarChar(255)
  fileType         String?          @map("file_type") @db.VarChar(150)
  fileSize         Int?             @map("file_size")
  recordedById     String           @map("recorded_by") @db.Uuid
  recordedBy       User             @relation("PaymentRecorder", fields: [recordedById], references: [id])
  voidedAt         DateTime?        @map("voided_at") @db.Timestamptz
  voidReason       String?          @map("void_reason")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  /// Its receipt's number (RC-2026-0031-n), given when the payment is recorded and never changed or reused
  /// (voiding or back-dating a payment moves no other receipt's number). Set by the database.
  receiptNo        Int?             @map("receipt_no")

  bankSteps OrderBankStep[]
  credits   CustomerCredit[]

  @@unique([orderId, receiptNo])
  @@index([orderId])
  @@index([paidOn])
  @@index([accountId])
  @@index([receiptId])
  @@index([companyId])
  @@map("payments")
}

// ============================================================================
// Shipping: a shipment (one or more per order) and its packing list
// ============================================================================

// ============================================================================
// Cash book: where our money is kept, and money moved between accounts
// ============================================================================

/**
 * A place money is kept, in one currency: an office cash box, a bank account, a wallet.
 */
model MoneyAccount {
  id             String           @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId      String           @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company        Company          @relation(fields: [companyId], references: [id])
  name           String           @db.VarChar(80)
  kind           MoneyAccountKind @default(bank)
  currency       String           @db.Char(3)
  /// What was in it on `openingOn`; movements from that day on are added.
  openingBalance Decimal          @default(0) @map("opening_balance") @db.Decimal(14, 2)
  openingOn      DateTime         @map("opening_on") @db.Date
  note           String?
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  payments        Payment[]
  factoryPayments FactoryPayment[]
  expenses        Expense[]
  expensesRepaid  Expense[]         @relation("ExpenseRepaidFrom")
  transfersOut    MoneyTransfer[]   @relation("TransferFrom")
  transfersIn     MoneyTransfer[]   @relation("TransferTo")
  receipts        CustomerReceipt[]
  credits         CustomerCredit[]

  @@unique([companyId, name])
  @@map("money_accounts")
}

/**
 * Money moved between two of our accounts: cash paid into the bank, dollars changed into rupees.
 */
model MoneyTransfer {
  id            String       @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId     String       @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company       Company      @relation(fields: [companyId], references: [id])
  fromAccountId String       @map("from_account_id") @db.Uuid
  fromAccount   MoneyAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId   String       @map("to_account_id") @db.Uuid
  toAccount     MoneyAccount @relation("TransferTo", fields: [toAccountId], references: [id])
  /// Left the first account (its currency) and arrived in the second (its currency).
  amountOut     Decimal      @map("amount_out") @db.Decimal(14, 2)
  amountIn      Decimal      @map("amount_in") @db.Decimal(14, 2)
  transferredOn DateTime     @map("transferred_on") @db.Date
  reference     String?      @db.VarChar(120)
  note          String?
  recordedById  String       @map("recorded_by") @db.Uuid
  recordedBy    User         @relation("TransferRecorder", fields: [recordedById], references: [id])
  voidedAt      DateTime?    @map("voided_at") @db.Timestamptz
  voidReason    String?      @map("void_reason")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([transferredOn])
  @@index([companyId])
  @@map("money_transfers")
}

/**
 * One transfer from a customer that pays several orders (oldest due first) and
 * leaves the rest as their credit. Its payments carry `receipt_id`; the cash
 * book shows the transfer once, for the whole amount.
 */
model CustomerReceipt {
  id               String        @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId        String        @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company          Company       @relation(fields: [companyId], references: [id])
  customerId       String        @map("customer_id") @db.Uuid
  customer         Customer      @relation(fields: [customerId], references: [id])
  /// What arrived, in the currency it arrived in, and the rate to the orders' currency (units per 1).
  receivedAmount   Decimal       @map("received_amount") @db.Decimal(14, 2)
  receivedCurrency String        @map("received_currency") @db.Char(3)
  /// The orders' currency (and the credit's) and how many received units make one of it.
  currency         String        @db.Char(3)
  rate             Decimal       @default(1) @db.Decimal(24, 14)
  accountId        String?       @map("account_id") @db.Uuid
  account          MoneyAccount? @relation(fields: [accountId], references: [id])
  paidOn           DateTime      @map("paid_on") @db.Date
  method           PaymentMethod @default(bank_transfer)
  reference        String?       @db.VarChar(120)
  paidByName       String?       @map("paid_by_name") @db.VarChar(120)
  note             String?
  recordedById     String        @map("recorded_by") @db.Uuid
  recordedBy       User          @relation("ReceiptRecorder", fields: [recordedById], references: [id])
  voidedAt         DateTime?     @map("voided_at") @db.Timestamptz
  voidReason       String?       @map("void_reason")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz

  payments Payment[]
  credits  CustomerCredit[]

  @@index([customerId])
  @@index([accountId])
  @@index([paidOn])
  @@index([companyId])
  @@map("customer_receipts")
}

/**
 * The customer's credit, as a ledger in one currency per row: in (money left
 * over, or kept from a cancelled order), used (paid an order: payment_id),
 * refund (paid back from account_id), fee (kept from a cancelled order as income;
 * not part of the balance). Balance = in − used − refund.
 */
model CustomerCredit {
  id           String           @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId    String           @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company      Company          @relation(fields: [companyId], references: [id])
  customerId   String           @map("customer_id") @db.Uuid
  customer     Customer         @relation(fields: [customerId], references: [id])
  /// in | used | refund | fee
  kind         String           @db.VarChar(10)
  amount       Decimal          @db.Decimal(14, 2)
  currency     String           @db.Char(3)
  receiptId    String?          @map("receipt_id") @db.Uuid
  receipt      CustomerReceipt? @relation(fields: [receiptId], references: [id])
  paymentId    String?          @map("payment_id") @db.Uuid
  payment      Payment?         @relation(fields: [paymentId], references: [id])
  /// The order it came from (cancelled) or was used on.
  orderId      String?          @map("order_id") @db.Uuid
  order        Order?           @relation(fields: [orderId], references: [id])
  /// A refund: the account it was paid from.
  accountId    String?          @map("account_id") @db.Uuid
  account      MoneyAccount?    @relation(fields: [accountId], references: [id])
  on           DateTime         @db.Date
  note         String?          @db.VarChar(500)
  recordedById String           @map("recorded_by") @db.Uuid
  recordedBy   User             @relation("CreditRecorder", fields: [recordedById], references: [id])
  voidedAt     DateTime?        @map("voided_at") @db.Timestamptz
  voidReason   String?          @map("void_reason")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([customerId])
  @@index([orderId])
  @@index([paymentId])
  @@index([receiptId])
  @@index([accountId])
  @@index([companyId])
  @@map("customer_credits")
}

/**
 * What we agreed to pay one factory for an order, in parts: an advance when we
 * order, the balance when they say ready (its date follows the order's ready
 * date), or on a fixed day. Paid status comes from the factory payments.
 */
model FactoryPaymentPlan {
  id        String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id])
  orderId   String    @map("order_id") @db.Uuid
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  factoryId String    @map("factory_id") @db.Uuid
  factory   Factory   @relation(fields: [factoryId], references: [id])
  label     String    @db.VarChar(80)
  percent   Decimal?  @db.Decimal(5, 2)
  amount    Decimal   @db.Decimal(14, 2)
  currency  String    @db.Char(3)
  /// on_order | on_ready | fixed
  dueRule   String    @map("due_rule") @db.VarChar(10)
  dueOn     DateTime? @map("due_on") @db.Date
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([orderId, factoryId])
  @@index([factoryId])
  @@index([companyId])
  @@map("factory_payment_plans")
}

/// One factory's part of an order: the ready date it gave (one per factory; the order's ready date is the
/// latest of them). factoryId null: the goods of an order whose lines name no factory.
model OrderFactory {
  id        String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id])
  orderId   String    @map("order_id") @db.Uuid
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  factoryId String?   @map("factory_id") @db.Uuid
  factory   Factory?  @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  readyOn   DateTime? @map("ready_on") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  /// One row per factory of the order (nulls not distinct: one row for an order with no factory).
  @@unique([orderId, factoryId])
  @@index([factoryId])
  @@index([companyId])
  @@map("order_factories")
}

// ============================================================================
// Insights: monthly sales targets, and each person's reminders done or snoozed
// ============================================================================

/**
 * What the company aims to sell in a month (orders won), in the main currency then.
 */
model SalesTarget {
  /// YYYY-MM
  month       String   @db.Char(7)
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId   String   @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id])
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @db.Char(3)
  updatedById String?  @map("updated_by") @db.Uuid
  updatedBy   User?    @relation("TargetUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([companyId, month])
  @@map("sales_targets")
}

/**
 * A reminder a person marked done or put off. Reminders themselves are worked out from the data each time.
 */
/// A person's sales target for a month (the company's is SalesTarget). Home and Insights measure against it.
model PersonTarget {
  /// YYYY-MM
  month       String   @db.Char(7)
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId   String   @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company     Company  @relation(fields: [companyId], references: [id])
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation("PersonTargetOwner", fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @db.Char(3)
  updatedById String?  @map("updated_by") @db.Uuid
  updatedBy   User?    @relation("PersonTargetUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([companyId, month, userId])
  @@index([userId])
  @@map("person_targets")
}

model ReminderState {
  userId       String    @map("user_id") @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId    String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company      Company   @relation(fields: [companyId], references: [id])
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What it is about, e.g. "pay:<instalment id>" or "quote-expiring:<revision id>".
  key          String    @db.VarChar(120)
  snoozedUntil DateTime? @map("snoozed_until") @db.Date
  doneAt       DateTime? @map("done_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@id([userId, key])
  @@index([companyId])
  @@map("reminder_states")
}

// ============================================================================
// Platform: the companies using the app, their plans and payments, client
// inquiries (leads), platform admins. Not visible to company connections
// (the kebo_app role has no access to these tables).
// ============================================================================

/// client: a paying company; demo: made by the platform admin to try it (a few days); trial: self sign-up.
enum CompanyKind {
  client
  demo
  trial
}

/// active: normal; read_only: can look but not change; off: nobody can sign in; deleted: data removed, name held.
enum CompanyStatus {
  active
  read_only
  off
  deleted
}

enum LeadStatus {
  new
  contacted
  demo
  client
  lost
}

enum LeadSource {
  form
  sign_up
  manual
  /// The "Questions?" form on the marketing site.
  contact
}

/// One company using the app. Every company row elsewhere carries its id.
model Company {
  id                String        @id @default(uuid()) @db.Uuid
  /// Short name: the future address (name.rfq…); a-z, 0-9 and "-".
  slug              String        @unique @db.VarChar(30)
  name              String        @db.VarChar(120)
  kind              CompanyKind   @default(client)
  status            CompanyStatus @default(active)
  /// Why it is read-only or off ("Demo ended", "Payment overdue", "Switched off by the platform admin").
  statusReason      String?       @map("status_reason") @db.VarChar(200)
  /// Set when the platform admin changed the status by hand: the automatic rules leave it alone.
  statusManual      Boolean       @default(false) @map("status_manual")
  planId            String?       @map("plan_id") @db.Uuid
  plan              Plan?         @relation(fields: [planId], references: [id])
  /// Modules the platform admin switched off for this company, on top of its plan ("less management").
  featuresOff       String[]      @default([]) @map("features_off")
  startsOn          DateTime      @default(dbgenerated("CURRENT_DATE")) @map("starts_on") @db.Date
  /// Paid until (clients): after it the company is overdue.
  renewsOn          DateTime?     @map("renews_on") @db.Date
  /// Demos and trials: when it ends.
  endsAt            DateTime?     @map("ends_at") @db.Timestamptz
  /// Demo: "ends tomorrow" emails sent for this end date.
  endingNoticeFor   DateTime?     @map("ending_notice_for") @db.Timestamptz
  /// The previous short name, kept working until previousSlugUntil after a rename.
  previousSlug      String?       @map("previous_slug") @db.VarChar(30)
  previousSlugUntil DateTime?     @map("previous_slug_until") @db.Timestamptz
