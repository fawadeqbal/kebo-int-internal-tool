// Kebo deal tracker: the data model.
//
// Conventions
// - Tables and columns are snake_case in Postgres (@@map / @map); models are PascalCase.
// - Money: Decimal(14,2) columns, always handled as integer minor units in code (@kebo/money).
// - Calendar dates (due, issued, paid) are DATE columns with no time of day.
// - Business records are soft-deleted (deleted_at) so history never disappears.
// - Enum values match @kebo/shared/enums (a test checks they stay in sync).
// - Snapshot JSON columns freeze who a document was for/from when it was sent or issued.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

/// What happened at one sign-in attempt.
enum SignInResult {
  signed_in
  code_needed
  wrong_password
  unknown_email
  wrong_code
  locked
  switched_off
  too_many
}

enum InquiryStage {
  new
  sourcing
  quoted
  won
  lost
}

enum InquiryChannel {
  website
  whatsapp
  wechat
  email
  phone
  visit
  other
}

enum Priority {
  low
  normal
  high
  urgent
}

enum LostReason {
  price_too_high
  no_reply
  factory_cannot_supply
  bought_elsewhere
  customer_cancelled
  duplicate_or_spam
  other
}

enum CustomerType {
  company
  individual
}

/// One option of a quotation revision: open while the customer decides; then one is accepted and the others not chosen.
enum OptionStatus {
  open
  accepted
  not_chosen
}

enum RevisionStatus {
  draft
  sent
  accepted
  rejected
  expired
  superseded
  /// Accepted, but its order was later cancelled.
  void
}

enum LineType {
  goods
  service
  charge
}

/// The costs between a factory's price basis and ours (to the port, sea freight, insurance, destination delivery, import duties).
enum BasisStep {
  to_port
  freight
  insurance
  delivery
  duties
}

enum Incoterm {
  EXW
  FCA
  FAS
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP
}

enum BalanceTerms {
  before_shipment
  against_bl_copy
  after_arrival
  letter_of_credit
}

enum OrderStatus {
  open
  closed
  cancelled
}

/// Confirmed → In production → Shipped → Done, one button at a time (cancelled is the status).
enum OrderStage {
  confirmed
  in_production
  shipped
  done

  @@map("order_stage")
}

enum PaymentKind {
  deposit
  balance
  other
}

/// Where money is kept: cash in the office, a bank account, a wallet (Alipay, JazzCash…).
enum MoneyAccountKind {
  cash
  bank
  wallet
}

enum PaymentMethod {
  bank_transfer
  letter_of_credit
  cash
  cheque
  online
  /// Paid from the customer's credit (money we already held for them).
  credit
  other
}

/// How the customer pays for an order: informally (cash, Alipay, WeChat, a personal account), on a bank contract, or by letter of credit.
enum PaymentRoute {
  informal
  bank_contract
  letter_of_credit
}

/// Where a bank contract or LC stands.
enum BankContractStatus {
  draft
  opened
  amended
  documents_presented
  paid
  closed
}

/// Asking a factory for a price for an inquiry, and what came of it.
enum FactoryRequestStatus {
  sent
  quoted
  declined
  no_reply
}

enum ShipMode {
  sea
  air
  road
  rail
}

/// Booked with the forwarder → loaded → on the way → arrived → cleared customs.
enum ShipmentStatus {
  planned
  booked
  loaded
  departed
  arrived
  cleared
}

/// The papers that go with a shipment to the banks and the customer.
enum OrderDocumentKind {
  bill_of_lading
  airway_bill
  packing_list
  commercial_invoice
  proforma_invoice
  sales_contract
  certificate_of_origin
  insurance
  inspection
  other
}

enum OrderDocumentStatus {
  missing
  draft
  ready
  /// Kept outside the app (where: kept_where); counts as done.
  elsewhere
}

/// The bank chain for the documents: our bank → courier to the customer's bank (copies to the customer) → they pay their bank → it reaches us.
enum BankStepKind {
  sent_to_our_bank
  couriered_to_customer_bank
  /// The papers reached the customer's bank (an LC's deferred days count from here).
  customer_bank_received
  copies_to_customer
  customer_paid_bank
  bank_paid_us
}

enum SatResult {
  pending
  pass
  fail
  not_applicable
}

enum ClaimStatus {
  open
  with_factory
  resolved
  rejected
}

// ============================================================================
// Platform: people, sign-in, settings, numbering, audit, notifications
// ============================================================================

/// A set of permissions people are given (Security). The key never changes; presets: admin (Super Admin), manager, staff.
model Role {
  key            String   @db.VarChar(40)
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId      String   @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company        Company  @relation(fields: [companyId], references: [id])
  name           String   @db.VarChar(60)
  description    String?  @db.VarChar(300)
  /// Permission names (@kebo/shared PERMISSIONS); ignored for the Super Admin, who has every one.
  permissions    String[] @default([])
  superAdmin     Boolean  @default(false) @map("super_admin")
  /// Everyone in the role must use two-step sign-in: they set it up before they can do anything else.
  requireTwoStep Boolean  @default(false) @map("require_two_step")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users User[]

  @@id([companyId, key])
  @@unique([companyId, name])
  @@map("roles")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId       String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company         Company   @relation(fields: [companyId], references: [id])
  /// Set on the hidden account a platform admin works through when they open this company.
  platformAdminId String?   @map("platform_admin_id") @db.Uuid
  name            String    @db.VarChar(120)
  email           String    @db.VarChar(254)
  passwordHash    String    @map("password_hash")
  /// The role's key.
  role            String    @db.VarChar(40)
  access          Role      @relation(fields: [companyId, role], references: [companyId, key], onUpdate: Cascade)
  isActive        Boolean   @default(true) @map("is_active")
  /// Built-in account that records website inquiries; can never sign in.
  isSystem        Boolean   @default(false) @map("is_system")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  failedLogins    Int       @default(0) @map("failed_logins")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz
  /// Two-step sign-in: encrypted authenticator secret; on once totpEnabledAt is set.
  totpSecret      String?   @map("totp_secret")
  totpEnabledAt   DateTime? @map("totp_enabled_at") @db.Timestamptz
  totpLastStep    Int?      @map("totp_last_step")
  /// sha256 hashes of unused recovery codes.
  recoveryCodes   String[]  @default([]) @map("recovery_codes")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions      Session[]
  signIns       SignIn[]
  devices       DeviceToken[]
  notifications Notification[]
  assignedDeals Inquiry[]          @relation("InquiryAssignee")
  createdDeals  Inquiry[]          @relation("InquiryCreator")
  orderMoves    OrderStageChange[]
  factories     Factory[]          @relation("FactoryOwner")
  factoryPaid   FactoryPayment[]   @relation("FactoryPaymentPaidBy")
  expensesPaid  Expense[]          @relation("ExpensePaidBy")

  reminderStates ReminderState[]

  /// What they made or did (kept when they are switched off; people are not deleted).
  relCustomerCreator        Customer[]           @relation("CustomerCreator")
  relFactoryCreator         Factory[]            @relation("FactoryCreator")
  relInquiryStageChanger    InquiryStageChange[] @relation("InquiryStageChanger")
  relAssignmentAssignee     InquiryAssignment[]  @relation("AssignmentAssignee")
  relAssignmentAssigner     InquiryAssignment[]  @relation("AssignmentAssigner")
  relNoteAuthor             InquiryNote[]        @relation("NoteAuthor")
  relAttachmentUploader     Attachment[]         @relation("AttachmentUploader")
  relFactoryQuoteCreator    FactoryQuote[]       @relation("FactoryQuoteCreator")
  relRevisionCreator        QuotationRevision[]  @relation("RevisionCreator")
  relOrderCreator           Order[]              @relation("OrderCreator")
  relFactoryPaymentRecorder FactoryPayment[]     @relation("FactoryPaymentRecorder")
  relExpenseRecorder        Expense[]            @relation("ExpenseRecorder")
  relPaymentRecorder        Payment[]            @relation("PaymentRecorder")
  relTransferRecorder       MoneyTransfer[]      @relation("TransferRecorder")
  relTargetUpdater          SalesTarget[]        @relation("TargetUpdater")
  relAuditUser              AuditLog[]           @relation("AuditUser")
  relFactoryRequestCreator  FactoryRequest[]     @relation("FactoryRequestCreator")
  relOrderSatEngineer       Order[]              @relation("OrderSatEngineer")
  relPersonTarget           PersonTarget[]       @relation("PersonTargetOwner")
  relPersonTargetUpdater    PersonTarget[]       @relation("PersonTargetUpdater")
  relChecklistAssignee      OrderChecklistItem[] @relation("ChecklistAssignee")
  relChecklistDoneBy        OrderChecklistItem[] @relation("ChecklistDoneBy")
  relChecklistCreator       OrderChecklistItem[] @relation("ChecklistCreator")
  relReceiptRecorder        CustomerReceipt[]    @relation("ReceiptRecorder")
  relCreditRecorder         CustomerCredit[]     @relation("CreditRecorder")
  relPapersMade             OrderPaper[]         @relation("PaperMadeBy")
  relOrderFacts             OrderFact[]          @relation("OrderFactHandledBy")
  relInquiryFacts           InquiryFact[]        @relation("InquiryFactHandledBy")
  relSubmissionsSent        MoneySubmission[]    @relation("SubmissionSubmittedBy")
  relSubmissionsDecided     MoneySubmission[]    @relation("SubmissionDecidedBy")
  relRecordNotes            RecordNote[]         @relation("RecordNoteAuthor")
  relFollowUpsAssigned      FollowUp[]           @relation("FollowUpAssignee")
  relFollowUpsCreated       FollowUp[]           @relation("FollowUpCreatedBy")
  relFollowUpsDone          FollowUp[]           @relation("FollowUpDoneBy")

  @@unique([companyId, email])
  @@map("users")
}

/// One row per signed-in browser or phone; the token only carries this id, so sign-out and deactivation end sessions at once.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId      String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company        Company   @relation(fields: [companyId], references: [id])
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  userAgent      String?   @map("user_agent") @db.VarChar(300)
  ip             String?   @db.VarChar(64)
  /// Signed in, but the second step (authenticator code) is not done yet.
  pendingTwoStep Boolean   @default(false) @map("pending_two_step")

  devices DeviceToken[]

  @@index([userId])
  @@index([companyId])
  @@map("sessions")
}

/// Every sign-in attempt, right or wrong (Security → Sign-ins; My account shows a person's own).
model SignIn {
  id        String       @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String       @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company      @relation(fields: [companyId], references: [id])
  /// Null when the email is not anyone's.
  userId    String?      @map("user_id") @db.Uuid
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String       @db.VarChar(254)
  result    SignInResult
  /// e.g. "with a recovery code".
  detail    String?      @db.VarChar(120)
  ip        String       @db.VarChar(64)
  userAgent String?      @map("user_agent") @db.VarChar(300)
  at        DateTime     @default(now()) @db.Timestamptz

  @@index([at])
  @@index([userId, at])
  @@index([companyId])
  @@map("sign_ins")
}

/// Phones that receive push notifications.
model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId  String   @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id])
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String?  @map("session_id") @db.Uuid
  session    Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// One row per phone per company (the same phone may be signed in to two companies).
  token      String
  platform   String   @default("android") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz

  @@unique([companyId, token])
  @@index([userId])
  @@index([companyId])
  @@map("device_tokens")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company   @relation(fields: [companyId], references: [id])
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(60)
  title     String    @db.VarChar(255)
  body      String?
  link      String?   @db.VarChar(255)
  /// Stops the reminder job sending the same reminder twice.
  dedupeKey String?   @map("dedupe_key") @db.VarChar(200)
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([companyId])
  @@map("notifications")
}

/// Who changed what, with old and new values.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId  String   @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id])
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.Uuid
  summary    String?
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  /// Why the change was made (asked where a change affects others; see @kebo/shared workflows/reasons).
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([companyId])
  @@map("audit_logs")
}

/// Company profile, defaults, reminder rules, plan timings: one JSON value per key.
model Setting {
  key       String   @db.VarChar(100)
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String   @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([companyId, key])
  @@map("settings")
}

/// Gap-free yearly counters for document numbers (RFQ-2026-0001, SO-2026-0001…).
model Counter {
  key       String  @db.VarChar(50)
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId String  @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])
  value     Int     @default(0)

  @@id([companyId, key])
  @@map("counters")
}

// ============================================================================
// Parties: customers (with contacts) and factories
// ============================================================================

model Customer {
  id              String       @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId       String       @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company         Company      @relation(fields: [companyId], references: [id])
  type            CustomerType @default(company)
  name            String       @db.VarChar(200)
  /// ISO 3166-1 alpha-2 (e.g. NG, AE): where the goods go. China (CN) means a domestic sale with VAT.
  country         String       @db.Char(2)
  address         String?
  /// Business license / tax number (shown on documents as "Business License Number").
  taxNo           String?      @map("tax_no") @db.VarChar(60)
  /// Registration number (shown on documents as "Reg. Number").
  regNo           String?      @map("reg_no") @db.VarChar(60)
  defaultCurrency String       @default("USD") @map("default_currency") @db.Char(3)
  /// Short letters for the customer on documents, e.g. "TN" in proforma KEB260916TN07. Empty: taken from the name.
  initials        String?      @db.VarChar(6)
  notes           String?
  createdById     String?      @map("created_by") @db.Uuid
  createdBy       User?        @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  contacts     Contact[]
  inquiries    Inquiry[]
  orders       Order[]
  payments     Payment[]
  expenses     Expense[]
  receipts     CustomerReceipt[]
  credits      CustomerCredit[]
  orderFacts   OrderFact[]
  inquiryFacts InquiryFact[]
  recordNotes  RecordNote[]
  followUps    FollowUp[]

  @@index([name])
  @@index([country])
  @@index([companyId])
  @@map("customers")
}

model Contact {
  id         String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId  String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company    Company   @relation(fields: [companyId], references: [id])
  customerId String    @map("customer_id") @db.Uuid
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String    @db.VarChar(120)
  position   String?   @db.VarChar(80)
  email      String?   @db.VarChar(254)
  phone      String?   @db.VarChar(40)
  whatsapp   String?   @db.VarChar(40)
  wechat     String?   @db.VarChar(80)
  isPrimary  Boolean   @default(false) @map("is_primary")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  inquiries    Inquiry[]
  inquiryNotes InquiryNote[] @relation("InquiryNoteContact")
  recordNotes  RecordNote[]  @relation("RecordNoteContact")

  @@index([customerId])
  @@index([email])
  @@index([phone])
  @@index([whatsapp])
  @@index([companyId])
  @@map("contacts")
}

model Factory {
  id            String    @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId     String    @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company       Company   @relation(fields: [companyId], references: [id])
  name          String    @db.VarChar(200)
  contactPerson String?   @map("contact_person") @db.VarChar(120)
  phone         String?   @db.VarChar(40)
  wechat        String?   @db.VarChar(80)
  email         String?   @db.VarChar(254)
  address       String?
  bankDetails   String?   @map("bank_details")
  notes         String?
  /// The person in our team who looks after this factory.
  ownerId       String?   @map("owner_id") @db.Uuid
  owner         User?     @relation("FactoryOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById   String?   @map("created_by") @db.Uuid
  createdBy     User?     @relation("FactoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  quotes     FactoryQuote[]
  payments   FactoryPayment[]
  expenses   Expense[]
  orderLines OrderLine[]

  requests       FactoryRequest[]
  checklistItems OrderChecklistItem[]
  paymentPlans   FactoryPaymentPlan[]
  orderParts     OrderFactory[]
  orderFacts     FactoryOrderFact[]
  recordNotes    RecordNote[]
  followUps      FollowUp[]

  @@index([name])
  @@index([ownerId])
  @@index([companyId])
  @@map("factories")
}

// ============================================================================
// Sales: the inquiry (deal) and what the customer asked for
// ============================================================================

model Inquiry {
  id           String         @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId    String         @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company      Company        @relation(fields: [companyId], references: [id])
  /// RFQ-2026-0001
  refNo        String         @map("ref_no") @db.VarChar(30)
  customerId   String         @map("customer_id") @db.Uuid
  customer     Customer       @relation(fields: [customerId], references: [id])
  contactId    String?        @map("contact_id") @db.Uuid
  contact      Contact?       @relation(fields: [contactId], references: [id])
  channel      InquiryChannel @default(email)
  category     String         @db.VarChar(120)
  title        String         @db.VarChar(200)
  /// Anything else the customer said: destination port, standards, delivery…
  requirements String?
  priority     Priority       @default(normal)
  requiredBy   DateTime?      @map("required_by") @db.Date
  stage        InquiryStage   @default(new)
  onHold       Boolean        @default(false) @map("on_hold")
  lostReason   LostReason?    @map("lost_reason")
  lostNote     String?        @map("lost_note")
  assigneeId   String?        @map("assignee_id") @db.Uuid
  assignee     User?          @relation("InquiryAssignee", fields: [assigneeId], references: [id])
  createdById  String         @map("created_by") @db.Uuid
  createdBy    User           @relation("InquiryCreator", fields: [createdById], references: [id])
  /// When it was won or lost (turnaround = closedAt − createdAt).
  closedAt     DateTime?      @map("closed_at") @db.Timestamptz
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  items         RequestedItem[]
  stageChanges  InquiryStageChange[]
  assignments   InquiryAssignment[]
  notes         InquiryNote[]
  followUps     FollowUp[]
  attachments   Attachment[]
  factoryQuotes FactoryQuote[]
  quotation     Quotation?
  fact          InquiryFact?
  orderFacts    OrderFact[]
  /// At most one order that is not cancelled (partial unique index in the integrity migration).
  orders        Order[]
  expenses      Expense[]

  factoryRequests FactoryRequest[]

  @@unique([companyId, refNo])
  @@index([stage])
  @@index([assigneeId])
  @@index([customerId])
  @@index([createdAt])
  @@map("inquiries")
}

model RequestedItem {
  id          String          @id @default(uuid()) @db.Uuid
  /// The company this row belongs to (row-level security keeps companies apart; filled from the connection).
  companyId   String          @default(dbgenerated("app_company()")) @map("company_id") @db.Uuid
  company     Company         @relation(fields: [companyId], references: [id])
  inquiryId   String          @map("inquiry_id") @db.Uuid
  inquiry     Inquiry         @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// A part of another item, split at factory pricing (numbered 3.1, 3.2 under item 3). One level only.
  parentId    String?         @map("parent_id") @db.Uuid
  parent      RequestedItem?  @relation("ItemParts", fields: [parentId], references: [id], onDelete: Cascade)
  parts       RequestedItem[] @relation("ItemParts")
  description String
  model       String?         @db.VarChar(120)
  quantity    Decimal         @db.Decimal(12, 2)
  unit        String          @default("pcs") @db.VarChar(20)
  targetPrice Decimal?        @map("target_price") @db.Decimal(14, 2)
  sortOrder   Int             @default(0) @map("sort_order")

  factoryLines FactoryQuoteLine[] @relation("AnswersItem")
  quoteLines   QuoteLine[]

  @@index([inquiryId])
  @@index([parentId])
  @@index([companyId])
  @@map("requested_items")
}

/// Every stage move, automatic or by hand; turnaround and time-in-stage come from here.
