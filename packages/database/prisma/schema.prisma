  contactEmail      String?       @map("contact_email") @db.VarChar(254)
  notes             String?
  lastActiveAt      DateTime?     @map("last_active_at") @db.Timestamptz
  /// The company website form's key: the form sends it, and it decides the company (Settings → Website form).
  formKey           String        @unique @default(dbgenerated("replace(((gen_random_uuid())::text || (gen_random_uuid())::text), '-'::text, ''::text)")) @map("form_key") @db.VarChar(64)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  subscriptionPayments SubscriptionPayment[]
  leads                Lead[]
  platformLog          PlatformLog[]

  roles               Role[]
  users               User[]
  sessions            Session[]
  signIns             SignIn[]
  deviceTokens        DeviceToken[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  settings            Setting[]
  counters            Counter[]
  customers           Customer[]
  contacts            Contact[]
  factories           Factory[]
  inquiries           Inquiry[]
  requestedItems      RequestedItem[]
  inquiryStageChanges InquiryStageChange[]
  inquiryAssignments  InquiryAssignment[]
  inquiryNotes        InquiryNote[]
  attachments         Attachment[]
  factoryQuotes       FactoryQuote[]
  factoryQuoteLines   FactoryQuoteLine[]
  quotations          Quotation[]
  quotationRevisions  QuotationRevision[]
  quotationOptions    QuotationOption[]
  optionCosts         OptionCost[]
  orderCosts          OrderCost[]
  quoteLines          QuoteLine[]
  orders              Order[]
  orderLines          OrderLine[]
  orderStageChanges   OrderStageChange[]
  paymentPlanItems    PaymentPlanItem[]
  factoryPayments     FactoryPayment[]
  expenses            Expense[]
  payments            Payment[]
  moneyAccounts       MoneyAccount[]
  moneyTransfers      MoneyTransfer[]
  salesTargets        SalesTarget[]
  reminderStates      ReminderState[]
  personTargets       PersonTarget[]
  factoryRequests     FactoryRequest[]
  orderBankContracts  OrderBankContract[]
  shipments           Shipment[]
  orderDocuments      OrderDocument[]
  orderBankSteps      OrderBankStep[]
