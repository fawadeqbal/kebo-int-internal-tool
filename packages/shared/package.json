{
  "name": "@kebo/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Domain vocabulary and pure business rules shared by the API and the web: enums, labels, permissions, workflows, the next-step engine and input schemas.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.mjs", "require": "./dist/index.js" } },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": { "@kebo/money": "workspace:*", "@kebo/utils": "workspace:*", "zod": "4.6.7" },
  "devDependencies": {
    "@kebo/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "tsup": "^8.5.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
